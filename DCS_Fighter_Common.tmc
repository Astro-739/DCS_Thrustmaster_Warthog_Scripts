// -------------------- FIGHTER COMMON CONFIGURATION ----------------------------------------------

int dcs_fighter_common_configuration()
{
	Configure(&HCougar, MODE_EXCLUDED);
	Configure(&Joystick, MODE_EXCLUDED);                    // Warthog Joystick
	Configure(&JoystickF18, MODE_EXCLUDED);
	//Configure(&Throttle, MODE_EXCLUDED);                  // Warthog Throttle included
	Configure(&A320Pilot, MODE_EXCLUDED);
	Configure(&A320Copilot, MODE_EXCLUDED);
	Configure(&TCAQuadrant12, MODE_EXCLUDED);
	Configure(&TCAQuadrant34, MODE_EXCLUDED);
	Configure(&TCAYokeBoeing, MODE_EXCLUDED);
	Configure(&TCAQBoeing12, MODE_EXCLUDED);
	Configure(&TCAQBoeing34, MODE_EXCLUDED);
	Configure(&TCASidestickXPilot, MODE_EXCLUDED);
	Configure(&TCASidestickXCopilot, MODE_EXCLUDED);
	Configure(&ViperTQS, MODE_EXCLUDED);
	Configure(&ViperBBox, MODE_EXCLUDED);
	//Configure(&AVA_F16, MODE_EXCLUDED);					// AVA F16 included
    Configure(&AVA_F16L, MODE_EXCLUDED);
    Configure(&AVA_F18, MODE_EXCLUDED);
    Configure(&AVA_F18L, MODE_EXCLUDED);
    Configure(&AVA_SolR, MODE_EXCLUDED);
    Configure(&AVA_SolRL, MODE_EXCLUDED);
	Configure(&FarmStickRight, MODE_EXCLUDED);
	Configure(&FarmStickLeft, MODE_EXCLUDED);
	Configure(&FarmStickXboxRight, MODE_EXCLUDED);
	Configure(&FarmStickXboxLeft, MODE_EXCLUDED);
	Configure(&T16000, MODE_EXCLUDED);
	Configure(&T16000L, MODE_EXCLUDED);
	//Configure(&LMFD, MODE_EXCLUDED);						// Left MFD included
	Configure(&RMFD, MODE_EXCLUDED);						// Right MFD
	Configure(&TFRPRudder, MODE_EXCLUDED);
	Configure(&TFRPHARudder, MODE_EXCLUDED);
	Configure(&TWCSThrottle, MODE_EXCLUDED);
	Configure(&Sol_F16, MODE_EXCLUDED);
	Configure(&Sol_F16L, MODE_EXCLUDED);
	Configure(&Sol_F18, MODE_EXCLUDED);
	Configure(&Sol_F18L, MODE_EXCLUDED);
	Configure(&Sol_SolR, MODE_EXCLUDED);
	Configure(&Sol_SolRL, MODE_EXCLUDED);
	
	if (Init(&EventHandle)) return 1;
	
	SetKBRate(40, 50);																							// (a < b) a = pulse duration, b = delay duration
	SetKBLayout(KB_ENG);
	
	// --------------------- IOUMD Buttons --------------------------
	
	SetShiftButton(&AVA_F16, S4, &Throttle, BSF, BSB, 0);

	// ---------------------- Warthog LEDs --------------------------

	throttle_led1_on	= LED( &Throttle, LED_ONOFF, LED_CURRENT+LED1 );
	throttle_led1_off	= LED( &Throttle, LED_ONOFF, LED_CURRENT-LED1 );
	throttle_led2_on	= LED( &Throttle, LED_ONOFF, LED_CURRENT+LED2 );
	throttle_led2_off	= LED( &Throttle, LED_ONOFF, LED_CURRENT-LED2 );
	throttle_led3_on	= LED( &Throttle, LED_ONOFF, LED_CURRENT+LED3 );
	throttle_led3_off	= LED( &Throttle, LED_ONOFF, LED_CURRENT-LED3 );
	throttle_led4_on	= LED( &Throttle, LED_ONOFF, LED_CURRENT+LED4 );
	throttle_led4_off	= LED( &Throttle, LED_ONOFF, LED_CURRENT-LED4 );
	throttle_led5_on	= LED( &Throttle, LED_ONOFF, LED_CURRENT+LED5 );
	throttle_led5_off	= LED( &Throttle, LED_ONOFF, LED_CURRENT-LED5 );



}	// =====  end dcs_fighter_common_configuration()  =============================================



// -------------------- FIGHTER COMMON FUNCTIONS --------------------------------------------------

int dcs_fighter_common_functions()
{
	// AI Flight Comms
	flight_engagebandits 		= CHAIN( DOWN+L_WIN, D(10), PULSE+'b', D(), UP+L_WIN );									// Flight - Engage Bandits
	flight_coverme				= CHAIN( DOWN+L_WIN, D(10), PULSE+'w', D(), UP+L_WIN );									// Flight - Cover Me
	flight_pincerright			= CHAIN( PULSE+USB[0x31], D(200), PULSE+F1, D(200), PULSE+F2, D(200), PULSE+F1 ); 		// Radio menu (\), Flight, Go Pincer, Right
	flight_attackgroundtargets 	= CHAIN( DOWN+L_WIN, D(10), PULSE+'g', D(), UP+L_WIN );									// Flight - Attack ground targets
	flight_attackgroundtargets	= CHAIN( PULSE+USB[0x31], D(200), PULSE+F1, D(200), PULSE+F1, D(200), PULSE+F5 ); 		// Radio menu (\), Flight, Engage, Attack ground targets
	flight_attackairdefences 	= CHAIN( DOWN+L_WIN, D(10), PULSE+'d', D(), UP+L_WIN );									// Flight - Attack air defenses
	flight_attackmytarget		= CHAIN( DOWN+L_WIN, D(10), PULSE+'q', D(), UP+L_WIN );									// Flight - Attack My Target
	flight_completemissionrejoin= CHAIN( DOWN+L_WIN, D(10), PULSE+'r', D(), UP+L_WIN );									// Flight - Complete mission and rejoin
	flight_rejoinformation		= CHAIN( DOWN+L_WIN, D(10), PULSE+'y', D(), UP+L_WIN );									// Flight - Rejoin Formation
	flight_rtb					= CHAIN( PULSE+USB[0x31], D(200), PULSE+F1, D(200), PULSE+F3, D(200), PULSE+F1 ); 		// Radio menu (\), Flight, Go To, RTB
	flight_gotoroute			= CHAIN( PULSE+USB[0x31], D(200), PULSE+F1, D(200), PULSE+F3, D(200), PULSE+F2 ); 		// Radio menu (\), Flight, Go To, Route
	flight_gototanker			= CHAIN( PULSE+USB[0x31], D(200), PULSE+F1, D(200), PULSE+F3, D(200), PULSE+F3 ); 		// Radio menu (\), Flight, Go To, Tanker
	flight_radaroffon			= SEQ( CHAIN( PULSE+USB[0x31], D(200), PULSE+F1, D(200), PULSE+F8, D(200), PULSE+F2 ), 	// Radio menu (\), Flight, Radar, Radar Off
									   CHAIN( PULSE+USB[0x31], D(200), PULSE+F1, D(200), PULSE+F8, D(200), PULSE+F1 )); // Radio menu (\), Flight, Radar, Radar On
	flight_fingerfour			= CHAIN( PULSE+USB[0x31], D(200), PULSE+F1, D(200), PULSE+F5, D(200), PULSE+F6 ); 		// Radio menu (\), Flight, Formation, Finger Four
	flight_spreadfour			= CHAIN( PULSE+USB[0x31], D(200), PULSE+F1, D(200), PULSE+F5, D(200), PULSE+F7 ); 		// Radio menu (\), Flight, Formation, Spread Four
	flight_trail				= CHAIN( PULSE+USB[0x31], D(200), PULSE+F1, D(200), PULSE+F5, D(200), PULSE+F2 ); 		// Radio menu (\), Flight, Formation, Trail
	flight_lineabreast			= CHAIN( PULSE+USB[0x31], D(200), PULSE+F1, D(200), PULSE+F5, D(200), PULSE+F1 ); 		// Radio menu (\), Flight, Formation, Line Abreast
	flight_echelonright			= CHAIN( PULSE+USB[0x31], D(200), PULSE+F1, D(200), PULSE+F5, D(200), PULSE+F4 ); 		// Radio menu (\), Flight, Formation, Echelon Right
	flight_echelonleft			= CHAIN( PULSE+USB[0x31], D(200), PULSE+F1, D(200), PULSE+F5, D(200), PULSE+F5 ); 		// Radio menu (\), Flight, Formation, Echelon Left
	flight_opencloseformation	= SEQ( CHAIN( PULSE+USB[0x31], D(200), PULSE+F1, D(200), PULSE+F5, D(200), PULSE+F8 ), 	// Radio menu (\), Flight, Formation, Open Formation
									   CHAIN( PULSE+USB[0x31], D(200), PULSE+F1, D(200), PULSE+F5, D(200), PULSE+F9 ));	// Radio menu (\), Flight, Formation, Close Formation
									   
	awacs_bogeydope				= CHAIN( DOWN+L_WIN, D(10), PULSE+'o', D(), UP+L_WIN ); 								// Request AWACS Bogey Dope
	awacs_vectorhomeairbase		= CHAIN( DOWN+L_WIN, D(10), PULSE+'u', D(), UP+L_WIN ); 								// Request AWACS Vector to Home Airbase
	awacs_vectorbullseye		= CHAIN( PULSE+USB[0x31], D(200), PULSE+F7, D(200), PULSE+F1 ); 						// Radio menu (\), AWACS, Vector to Bullseye
	awacs_vectortanker			= CHAIN( PULSE+USB[0x31], D(200), PULSE+F7, D(200), PULSE+F3 ); 						// Radio menu (\), AWACS, Vector to Tanker
	awacs_requestpicture		= CHAIN( PULSE+USB[0x31], D(200), PULSE+F7, D(200), PULSE+F5 ); 						// Radio menu (\), AWACS, Request Picture
	awacs_declare				= CHAIN( PULSE+USB[0x31], D(200), PULSE+F7, D(200), PULSE+F6 ); 						// Radio menu (\), AWACS, Declare

	jtac_checkin15				= CHAIN( PULSE+USB[0x31], D(200), PULSE+F4, D(200), PULSE+F1 ); 						// Radio menu (\), JTAC, Check in for 15
	jtac_followoncomms			= CHAIN( PULSE+USB[0x31], D(200), PULSE+F1 ); 											// Radio menu (\), JTAC, Follow-on Comms
	jtac_checkout				= CHAIN( PULSE+USB[0x31], D(200), PULSE+F2 ); 											// Radio menu (\), JTAC, Check Out

	ground_rearmrefuel			= CHAIN( DOWN+L_ALT, D(10), PULSE+USB[0x34], D(), UP+L_ALT );        			  							// Rearming and Refueling Window   (L_ALT+')
	ground_dtceditor			= CHAIN( DOWN+R_CTL+R_SHIFT, D(10), PULSE+'k', D(), UP+R_CTL+R_SHIFT );										// DTC editor window
	ground_wheelchocks_place	= CHAIN( PULSE+USB[0x31], D(200), PULSE+F11, D(200), PULSE+F8, D(200), PULSE+F4, D(200), PULSE+F1 );		// Radio menu (\), Prev, Ground crew, Wheel Chocks, Place
	ground_wheelchocks_remove	= CHAIN( PULSE+USB[0x31], D(200), PULSE+F11, D(200), PULSE+F8, D(200), PULSE+F4, D(200), PULSE+F2 );		// Radio menu (\), Prev, Ground crew, Wheel Chocks, Remove
	ground_elecpower_on			= CHAIN( PULSE+USB[0x31], D(200), PULSE+F11, D(200), PULSE+F8, D(200), PULSE+F2, D(200), PULSE+F1 ); 		// Radio menu (\), Prev, Ground crew, Ground Electric Power, On
	ground_elecpower_off		= CHAIN( PULSE+USB[0x31], D(200), PULSE+F11, D(200), PULSE+F8, D(200), PULSE+F2, D(200), PULSE+F2 ); 		// Radio menu (\), Prev, Ground crew, Ground Electric Power, Off
	ground_airsupply_connect	= CHAIN( PULSE+USB[0x31], D(200), PULSE+F11, D(200), PULSE+F8, D(200), PULSE+F5, D(200), PULSE+F1 );		// Radio menu (\), Prev, Ground crew, Ground Air Supply, Connect
	ground_airsupply_apply		= CHAIN( PULSE+USB[0x31], D(100), PULSE+F11, D(200), PULSE+F8, D(200), PULSE+F5, D(200), PULSE+F3 );		// Radio menu (\), Prev, Ground crew, Ground Air Supply, Apply
	ground_airsupply_disconnect	= CHAIN( PULSE+USB[0x31], D(200), PULSE+F11, D(200), PULSE+F8, D(200), PULSE+F5, D(200), PULSE+F2 );		// Radio menu (\), Prev, Ground crew, Ground Air Supply, Disconnect

	atc_requeststartup			= CHAIN( PULSE+USB[0x31], D(200), PULSE+F11, D(200), PULSE+F5, D(200), PULSE+F1, D(200), PULSE+F3 );		// Radio menu (\), Prev, ATC, Airfield, Request start-up
	atc_requesttaxitakeoff		= CHAIN( PULSE+USB[0x31], D(200), PULSE+F11, D(200), PULSE+F5, D(200), PULSE+F1, D(200), PULSE+F1 );		// Radio menu (\), Prev, ATC, Airfield, Request taxi/take-off
	atc_inbound					= CHAIN( PULSE+USB[0x31], D(200), PULSE+F5, D(200), PULSE+F1, D(200), PULSE+F1 ); 							// Radio menu (\), ATC, Airfield, Inbound
	atc_requestlanding			= CHAIN( PULSE+USB[0x31], D(200), PULSE+F1 );				 												// Request landing short menu
	
	tanker_inbound				= CHAIN( PULSE+USB[0x31], D(200), PULSE+F6, D(200), PULSE+F1, D(10000), PULSE+F12 ); 	// Radio menu (\), Tanker menu, inbound, 10s delay, Exit
	tanker_precontact			= CHAIN( PULSE+USB[0x31], D(200), PULSE+F1 );  											// Radio menu (\), Ready Pre-Contact (menu shortcut)

	cv_requestlaunch			= CHAIN( PULSE+USB[0x31], D(200), PULSE+F1, D(200), PULSE+F3, D(200), PULSE+F2 ); 		// TODO Radio menu (\), xxxxxxx
	cv_inbound					= SEQ( CHAIN( PULSE+USB[0x31], D(200), PULSE+F5, D(200), PULSE+F1, D(200), PULSE+F1 ), 	// Radio menu (\), ATC, CV, Inbound
									   CHAIN( PULSE+USB[0x31], D(200), PULSE+F2 )); 									// Radio menu (\), See you at 10 (menu shortcut)
	cv_salute					= CHAIN( DOWN+L_SHIFT, D(10), PULSE+'u', D(), UP+L_SHIFT ); 							// Salute
	cv_calltheball				= CHAIN( DOWN+L_WIN, D(10), PULSE+'x', D(), UP+L_WIN ); 								// Call the Ball
	
	uhf_radiomenu				= CHAIN( DOWN+R_ALT, D(10), PULSE+USB[0x31], D(), UP+R_ALT );							// Transmit Switch - UHF (radio menu)
	vhf_radiomenu				= CHAIN( DOWN+R_CTL, D(10), PULSE+USB[0x31], D(), UP+R_CTL );							// Transmit Switch - VHF (radio menu)
	radiomenu					= PULSE+USB[0x31];																		// Transmit Switch - radio menu
	radiomenu_exit				= PULSE+F12;																			// F12 exit radio menu

	// Heatblur CW server comms
	hbcw_picture_bogeydope		= CHAIN( PULSE+USB[0x31], D(200), PULSE+F10, D(200), PULSE+F1, D(200), PULSE+F1 ); 		// Radio menu (\), Other, EWR System, Bogey Dope
	hbcw_picture_declare		= CHAIN( PULSE+USB[0x31], D(200), PULSE+F10, D(200), PULSE+F1, D(200), PULSE+F2 ); 		// Radio menu (\), Other, EWR System, Declare
	hbcw_picture_enemy			= CHAIN( PULSE+USB[0x31], D(200), PULSE+F10, D(200), PULSE+F1, D(200), PULSE+F3 ); 		// Radio menu (\), Other, EWR System, Request Picture
	hbcw_picture_friend			= CHAIN( PULSE+USB[0x31], D(200), PULSE+F10, D(200), PULSE+F1, D(200), PULSE+F4 ); 		// Radio menu (\), Other, EWR System, Request Friendly Picture

	// SPS Contention server comms
	cont_picture_bogeydope		= CHAIN( PULSE+USB[0x31], D(200), PULSE+F10, D(200), PULSE+F1, D(200), PULSE+F1 ); 		// Radio menu (\), Other, EW Radar, Request Bogey Dope
	cont_picture_enemy			= CHAIN( PULSE+USB[0x31], D(200), PULSE+F10, D(200), PULSE+F1, D(200), PULSE+F2 ); 		// Radio menu (\), Other, EW Radar, Request Enemy Picture (max 6)
	cont_picture_friend			= CHAIN( PULSE+USB[0x31], D(200), PULSE+F10, D(200), PULSE+F1, D(200), PULSE+F4 ); 		// Radio menu (\), Other, EW Radar, Request Friendly Picture (max 6)
	
	// BSC server comms
	bsc_listmissions			= CHAIN( PULSE+USB[0x31], D(200), PULSE+F10, D(200), PULSE+F2, D(200), PULSE+F1 ); 		// Radio menu (\), Other, Missions, List Missions
	bsc_dialcode				= CHAIN( PULSE+USB[0x31], D(200), PULSE+F10, D(200), PULSE+F2, D(200), PULSE+F3 ); 		// Radio menu (\), Other, Missions, Dial Code
	bsc_startmission			= CHAIN( PULSE+USB[0x31], D(200), PULSE+F10, D(200), PULSE+F2, D(200), PULSE+F4 ); 		// Radio menu (\), Other, Missions, Start
	bsc_validatelanding			= CHAIN( PULSE+USB[0x31], D(200), PULSE+F10, D(200), PULSE+F1, D(200), PULSE+F3 ); 		// Radio menu (\), Other, Player, Validate Landing

	
	// -------------- Functions specified per airplane --------------
	
	// Target Management Switch / Armament Selector (can be specified per airplane)
	TMS_fwd 	= 0;
	TMS_aft 	= 0;
	TMS_right 	= 0;
	TMS_left 	= 0;

	// Display Management Switch (can be specified per airplane)
	DMS_fwd 	= 0;
	DMS_aft 	= 0;
	DMS_right 	= 0;
	DMS_left 	= 0;

	// Buttons (can be specified per airplane)
	LDGH_short	= 0;
	SC_short	= 0;

	// Start-up Sequence (can be specified per airplane)
	startup 	= CHAIN( R_SHIFT, D(10), 's' ); 																		// Battery / MAIN PWR Switch

	// Ground Crew Sequence (can be specified per airplane)
	groundcrew  = 0;																									// Ground Crew defined per aircraft when needed

	// Emergency Stores Jettison (can be specified per airplane)
	emergency_stores_jettison = CHAIN( L_SHIFT, D(10), 'e' );															// EMERGENCY STORES JETTISON Button

	// Drag Chute (can be specified per airplane)
	dragchute_deploy		= 0;																						// Drag Chute defined per aircraft when needed
	dragchute_release		= 0;

	// Speedbrakes (can be specified per airplane)
	speedbrakes_open		= DX32;																						// Open speedbrakes
	speedbrakes_close		= CHAIN( D(100), PULSE+DX31 );																// Close speedbrakes

	// Exterior Lights (can be specified per airplane)
	extlight_full 			= 0;
	extlight_position 		= 0;
	extlight_formation 		= 0;
	extlight_covert 		= 0;
	extlight_flashsteady 	= 0;

	// --------------------------------------------------------------

	// Trim
	trim_up		= CHAIN( R_CTL, D(10), '.' ); 																			// trim nose up
	trim_down	= CHAIN( R_CTL, D(10), ';' ); 																			// trim nose down
	trim_right	= CHAIN( R_CTL, D(10), '/' ); 																			// trim right wing down
	trim_left	= CHAIN( R_CTL, D(10), ',' ); 																			// trim left wing down

	// DX - Weapons and CM
	guntrigger_1st			= DX1;																						// Gun Trigger 1st stage
	guntrigger_2nd			= DX6;																						// Gun Trigger 2nd stage
	weaponrelease			= DX2;																						// Weapons Release Button
	cm_dispense				= DX19;																						// Countermeasure dispense button
	sidewinder_uncage		= DX23;																						// Sidewinder Uncage Button

	// DX - Radios
	radio1_voip				= DX27; 																					// Radio 1 (VOIP UHF)
	radio2_voip				= DX29; 																					// Radio 2 (VOIP VHF)
	radio3_acspecific		= DX28; 																					// Radio 3 (A/C specific function)
	radio4_acspecific		= DX30; 																					// Radio 4 (VOIP Intercom / A/C specific function)

	// DX - Systems
	nws						= DX3;																						// Node Wheel Steering
	canopy_toggle			= DX11; 																					// Canopy toggle
	wheelbrake				= DX12;																						// Wheel brake
	chinahat_fwd			= DX13; 																					// Antenna elevation up
	chinahat_back			= DX14; 																					// Antenna elevation down
	attcontrol_override		= DX22;																						// Manual attitude control override
	engine_ignition_left	= DX33;																						// Left engine ignition
	engine_ignition_right	= DX34; 																					// Right engine ignition
	apu_on					= DX35;																						// APU on
	apu_off					= DX36;																						// APU off
	reticle_depr_incr		= DX39; 																					// Reticle depression increase
	reticle_depr_decr		= DX40; 																					// Reticle depression decrease
	seat_up					= DX41; 																					// Seat position up
	seat_down				= DX42;																						// Seat position down
	nw_strut_extend			= DX43;																						// Nose wheel strut extend
	nw_strut_retract		= DX44; 																					// Nose wheel strut retract / kneel
	hook_extend				= DX45;																						// HOOK Switch - DOWN
	hook_retract			= DX46;																						// HOOK Switch - UP

	// Systems
	mastercaution			= CHAIN( DOWN+L_ALT, D(10), DOWN+'m', D(300), UP+'m', D(10), UP+L_ALT );					// Master caution button
	gear_up					= CHAIN( DOWN+L_SHIFT, D(10), PULSE+'g', D(), UP+L_SHIFT ); 								// Gear up 
	gear_down				= CHAIN( DOWN+L_CTL, D(10), PULSE+'g', D(), UP+L_CTL ); 									// Gear down
	eject					= CHAIN( DOWN+L_CTL, D(10), PULSE+'e', D(), UP+L_CTL ); 									// EJECT
	throttle_left_off		= CHAIN( DOWN+L_SHIFT, D(10), PULSE+END, D(), UP+L_SHIFT );									// Throttle Left - OFF
	throttle_left_idle		= CHAIN( DOWN+L_SHIFT, D(10), PULSE+HOME, D(), UP+L_SHIFT );								// Throttle Left - IDLE
	throttle_right_off		= CHAIN( DOWN+R_SHIFT, D(10), PULSE+END, D(), UP+R_SHIFT );									// Throttle Right - OFF
	throttle_right_idle		= CHAIN( DOWN+R_SHIFT, D(10), PULSE+HOME, D(), UP+R_SHIFT );								// Throttle Right - IDLE
	airrefuel_open			= CHAIN( DOWN+R_SHIFT, D(10), PULSE+'f', D(), UP+R_SHIFT );									// AIR REFUEL Switch - OPEN
	airrefuel_close			= CHAIN( DOWN+R_CTL, D(10), PULSE+'f', D(), UP+R_CTL );										// AIR REFUEL Switch - CLOSE
	sidewinder_volume_up	= CHAIN( L_CTL+L_SHIFT, D(10), '=' );
	sidewinder_volume_down	= CHAIN( L_CTL+L_SHIFT, D(10), '-' );
	radio1_volume_up		= CHAIN( L_ALT+L_SHIFT, D(10), '=' );
	radio1_volume_down		= CHAIN( L_ALT+L_SHIFT, D(10), '-' );
	rwr_volume_up			= CHAIN( R_CTL+L_SHIFT, D(10), '=' );
	rwr_volume_down			= CHAIN( R_CTL+L_SHIFT, D(10), '-' );

	// DX - Visual and Sound
	zoom_in					= DX7;																						// Zoom in (flat screen / IR)
	zoom_out				= DX9;																						// Zoom out (flat screen / IR)
	snapview_right			= DX8;																						// Snap view right (numpad_6)
	snapview_left			= DX10;																						// Snap view left (numpad_4)
	vrzoom_in				= DX15;																						// Zoom in (VR)
	vrzoom_spyglass			= DX16;																						// Zoom max (VR)
	mouseclick_left			= DX17;																						// Left mouse button
	mouseclick_right		= DX18;																						// Right mouse button
	discord_mute			= DX21; 																					// Discord mute toggle

	// Visual
	zoom_max				= CHAIN( DOWN+R_SHIFT, D(10), PULSE+USB[0x55], D(), UP+R_SHIFT );							// Snap zoom max (flat screen / IR) (R_SHIFT+KP*)
	zoom_normal				= PULSE+KPENT;																				// Snap zoom normal (flat screen / IR)
	recentre_irvr			= CHAIN( DOWN+R_CTL, D(10), PULSE+INS, D(), UP+R_CTL );										// Re-centre IR tracker / VR helmet
	ingamechat_toggle		= CHAIN( DOWN+L_CTL+L_SHIFT, D(10), PULSE+'y', D(), UP+L_CTL+L_SHIFT );						// Toggle in-game chat
	F10map_toggle			= SEQ( PULSE+F10, PULSE+F1 );																// Toggle F10 map

	// Cockpit Visuals
	pilotbody   			= CHAIN( DOWN+R_SHIFT, D(10), PULSE+'p', D(), UP+R_SHIFT );									// Pilot Body toggle
	sunglasses  			= CHAIN( DOWN+L_SHIFT, D(10), PULSE+'v', D(), UP+L_SHIFT ); 		  						// Sunglasses toggle (headgear next)
	charactercustm  		= CHAIN( DOWN+L_ALT, D(10), PULSE+';', D(), UP+L_ALT ); 		  							// Character Customisation
	mirrors     			= CHAIN( DOWN+L_SHIFT+R_SHIFT, D(10), PULSE+'m', D(), UP+L_SHIFT+R_SHIFT ); 				// Toggle Mirrors
	oxygenmask				= 0;																						// Oxygen Mask toggle
	visortinteffect_toggle 	= CHAIN( DOWN+L_CTL+R_SHIFT, D(10), PULSE+'v', D(), UP+L_CTL+R_SHIFT );						// Helmet visor tint effect toggle
	helmetvisor 			= CHAIN( DOWN+L_CTL, D(10), PULSE+'v', D(), UP+L_CTL, D(),									// Helmet visor toggle
									 EXEC( "if (!tinteffect) ActKey( PULSE+KEYON+visortinteffect_toggle );" 			// Activate Visor Tint Effect on first visor use
										   "tinteffect = 1;" ));

	// Kneeboard
	kneeboard_toggle		= CHAIN( DOWN+R_SHIFT, D(10), PULSE+'k', D(), UP+R_SHIFT );									// kneeboard on/off
	kneeboard_mark			= CHAIN( DOWN+R_CTL, D(10), PULSE+'k', D(), UP+R_CTL );										// kneeboard current position mark point
	kneeboard_nextpage		= PULSE+']'; 																				// kneeboard next page
	kneeboard_prevpage		= PULSE+'['; 																				// kneeboard previous page
	kneeboard_nextshcut		= CHAIN( DOWN+R_SHIFT+L_SHIFT, D(10), PULSE+']', D(), UP+R_SHIFT+L_SHIFT );					// kneeboard next shortcut
	kneeboard_prevshcut		= CHAIN( DOWN+R_SHIFT+L_SHIFT, D(10), PULSE+'[', D(), UP+R_SHIFT+L_SHIFT );					// kneeboard previous shortcut

	// Night Vision function
	nightvision_toggle 		= SEQ( CHAIN( DOWN+R_SHIFT, D(10), PULSE+'h', D(), UP+R_SHIFT, D(),							// Night vision goggles (NVG) on
										  EXEC( "nightvision = 1;"														//
										  		"printf(\"nightvision = 1\\xa\");" )),									//
					   			   CHAIN( DOWN+R_SHIFT, D(10), PULSE+'h', D(), UP+R_SHIFT, D(),							// Night vision goggles (NVG) off
										  EXEC( "nightvision = 0;"														//
										  		"printf(\"nightvision = 0\\xa\");" )));									//

	// Flashlight function
	flashlight_toggle 		= SEQ( CHAIN( DOWN+L_ALT, D(10), PULSE+'l', D(), UP+L_ALT, D(),								// Flashlight on
										  EXEC( "flashlight = 1;"														//
										  		"printf(\"flashlight = 1\\xa\");" )),									//
						  		   CHAIN( DOWN+L_ALT, D(10), PULSE+'l', D(), UP+L_ALT, D(),								// Flashlight off
										  EXEC( "flashlight = 0;"														// 
										  		"printf(\"flashlight = 0\\xa\");" )));									//

	// Brightness function
	brightness_up 			= REXEC( 100, 100, "if (nightvision) ActKey( PULSE+KEYON+R_CTL+R_SHIFT+'h' );"				// NVG brightness up
											   "else if (flashlight) ActKey( PULSE+KEYON+L_ALT+R_SHIFT+'.' );"			// Flashlight brightness up
											   "else ActKey( PULSE+KEYON+DX37 );" );									// HUD/HMCS/Reticle brightness up
	brightness_down 		= REXEC( 101, 100, "if (nightvision) ActKey( PULSE+KEYON+R_ALT+R_SHIFT+'h' );"				// NVG brightness down
											   "else if (flashlight) ActKey( PULSE+KEYON+L_ALT+R_SHIFT+',' );"			// Flashlight brightness down
											   "else ActKey( PULSE+KEYON+DX38 );" );									// HUD/HMCS/Reticle brightness down

	// External
	tacview_bookmark 		= CHAIN( DOWN+R_ALT, D(10), PULSE+'b', D(), UP+R_ALT );										// Tacview Bookmark

	// Controller Modes
	WHDN_mode_on			= EXEC( "WHDN_mode = 1;"																	// WHDN_mode on
									"printf(\"WHDN_mode = 1\\xa\");" );													// Print status to output window
	WHDN_mode_off			= EXEC( "WHDN_mode = 0;"																	// WHDN_mode off
									"printf(\"WHDN_mode = 0\\xa\");" );													// Print status to output window
	AAR_mode_on				= EXEC( "AAR_mode = 1;"																		// AAR_mode on
									"printf(\"AAR_mode = 1\\xa\");" );													// Print status to output window
	AAR_mode_off			= EXEC( "AAR_mode = 0;"																		// AAR_mode off
									"WHDN_mode = 0;"																	// WHDN_mode off as precaution to prevent conflicts
									"printf(\"AAR_mode = 0\\xa\");" );													// Print status to output window
	CAR_mode_on				= EXEC( "CAR_mode = 1;"																		// CAR_mode on
									"printf(\"CAR_mode = 1\\xa\");" );													// Print status to output window
	CAR_mode_off			= EXEC( "CAR_mode = 0;"																		// CAR_mode off
									"printf(\"CAR_mode = 0\\xa\");" );													// Print status to output window
	VR_mode_toggle			= EXEC( "VR_mode = !VR_mode;"																// Switch VR mode on/off
									"printf(\"VR_mode = %i\\xa\", VR_mode);" );											// Print state to output window
	COMM_mode_adjust		= EXEC( "COMM_mode = (COMM_mode + 1)%3;"													// Increase COMM-mode for each click, cycle back after 3
									"printf(\"COMM_mode = %i\\xa\", COMM_mode);" );										// Print to output window


}	// =====  end dcs_fighter_common_functions()  =================================================



// -------------------- FIGHTER COMMON CONTROLS ---------------------------------------------------

int dcs_fighter_common_controls()
{

	// ---------------------- INITIAL VALUES ------------------------

	printf( "\xa--- Initial Mode Values ---\xa" );																		// 
	printf( "AAR_mode = %i\xa", AAR_mode );																				// print initial AAR_mode
	printf( "CAR_mode = %i\xa", CAR_mode );																				// print initial CAR_mode
	printf( "WHDN_mode = %i\xa", WHDN_mode );																			// print initial WHDN_mode
	printf( "COMM_mode = %i\xa", COMM_mode );																			// print initial Server Comms mode
	printf( "VR_mode = %i\xa", VR_mode );																				// print initial VR_mode



	// ------------------------ FLIGHT STICK ------------------------

	// Camera/Gun Trigger
	// TG1
	MapKeyIOUMD(&AVA_F16, TG1, 			0,	 																			// IU - 
										guntrigger_1st, 																// OU - Trigger First Detent
									  	COMM_mode_adjust, 																// IM - Adjust Server comm_mode
									  	0,  																			// OM - 
							  			0,  																			// ID - 
									  	guntrigger_1st ); 																// OD - Trigger First Detent
	// TG2
	MapKeyIOUMD(&AVA_F16, TG2, 			0,																				// IU - 
										guntrigger_2nd, 																// OU - Trigger Second Detent
										0, 																				// IM - 
										0, 																				// OM - 
										0, 																				// ID - 
										guntrigger_2nd );																// OD - Trigger Second Detent

	// Nosewheel Steering Button
	// S1
	MapKeyIO(&AVA_F16, S1,  			F10map_toggle,																	// I - F10 map toggle
									 	nws ); 																			// O - Nosewheel Steering Button

	// Weapon Release Button
	// S2
	MapKeyIO(&AVA_F16, S2,  			emergency_stores_jettison, 														// I - EMERGENCY STORES JETTISON
										weaponrelease );																// O - Weapon Release


	// Target Management Switch (in JESTER switch section)

	// Display Management Switch (in JESTER switch section)


	// Trim Switch
	// H1U
	MapKeyIO(&AVA_F16, H1U, 			TEMPO( helmetvisor, 															// I - Helmet Visor toggle
						 	 				   mirrors, 500 ),   														// 	   [long] Toggle Mirrors
										trim_down ); 																	// O - trim nose down
	// H1D
	MapKeyIO(&AVA_F16, H1D, 			TEMPO( PULSE+F1, 																// I - F1 cockpit view
											   pilotbody, 500 ),														//	   [long] Pilot Body toggle
									 	trim_up ); 																		// O - trim nose up
	// H1R
	MapKeyIO(&AVA_F16, H1R, 			TEMPO( PULSE+F2, 																// I - F2 outside view
											   sunglasses, 500 ),														//     [long] Sunglasses toggle (headgear next)
									 	trim_right ); 																	// O - trim right wing down
	// H1L	
	MapKeyIO(&AVA_F16, H1L, 			TEMPO( PULSE+F6, 																// I - F6 weapon view
											   charactercustm, 500 ),													//     [long] Character Customisation window
									 	trim_left ); 																	// O - trim left wing down


	// JOYX
	MapAxis(&AVA_F16, JOYX, DX_X_AXIS, AXIS_NORMAL, MAP_ABSOLUTE);
	SetSCurve(&AVA_F16, JOYX, 0, 0, 0, 0, 0);
	// JOYY
	MapAxis(&AVA_F16, JOYY, DX_Y_AXIS, AXIS_NORMAL, MAP_ABSOLUTE);
	SetSCurve(&AVA_F16, JOYY, 0, 0, 0, 0, 0);
	// Rotate Axes
	RotateDXAxis(DX_X_AXIS, DX_Y_AXIS, -5);																				// rotate axes 5 deg right
	
	
	
 
	// ------------------------ THROTTLE ----------------------------


	// MIC Switch (in JESTER switch section)

	// Left Throttle Button
	MapKeyIO(&Throttle, LTB, 			eject, 																			// I - EJECT
										EXEC( "if (afterburnerdetent_present) {"										// O - If detent present
												   "afterburnerdetent(0);"												//       Engage afterburner
												   "afterburnerdetent_lifted = 1;"										// 	     Lift detent
												   "DXAxis( DX_ZROT_AXIS, -AMAX );"										//		 Left throttle to full afterburner
												   "DXAxis( DX_Z_AXIS, -AMAX );"										//		 Right throttle to full afterburner
											  "}" ));								

	// Canopy
	// RDRNRM
	MapKeyUMD(&Throttle, RDRNRM, 		0, 																				// U - 
										canopy_toggle,																	// M - Canopy - OPEN/CLOSE (always return switch to RDRDIS)
										0 );																			// D -  
	// RDRDIS
	MapKeyUMD(&Throttle, RDRDIS, 		0,																				// U -  
										0,																				// M - 
										0 );																			// D -  

	// Landing Gear
	// EACON
	MapKeyUMD(&Throttle, EACON,			0, 																				// U - 
										CHAIN( gear_up, D(), WHDN_mode_off ),											// M - Gear up; WHDN_mode off
										0 );																			// D -
	// EACOFF
	MapKeyUMD(&Throttle, EACOFF, 		0, 																				// U -
										CHAIN( gear_down, D(), WHDN_mode_on ), 											// M - Gear down; WHDN_mode on
										0 );																			// D -

	// Speedbrake Switch
	// SPDF
	MapKeyIO(&Throttle, SPDF, 			EXEC( "if (VR_mode) ActKey( KEYON+vrzoom_spyglass );"							// I - [VR] VR zoom max
											  "else ActKey( PULSE+KEYON+zoom_max );" ),									//	   snap zoom max   (R_SHIFT+KP*)
										speedbrakes_open );																// O - Open Speed Brakes
	MapKeyRIO(&Throttle, SPDF, 			EXEC( "if (VR_mode) ActKey( vrzoom_spyglass );"									// I - [VR] release VR zoom max (DX16)
											  "else ActKey( PULSE+KEYON+zoom_normal );" ),								//	   snap zoom normal
										speedbrakes_close );															// O - Close Speed Brakes
	// SPDB
	MapKeyIO(&Throttle, SPDB, 			EXEC( "if (WHDN_mode) ActKey( KEYON+wheelbrake );" ),							// I - [WHDN] wheel brake 
							  			speedbrakes_open );																// O - Open Speed Brakes Momentary
	MapKeyRIO(&Throttle, SPDB, 			EXEC( "if (WHDN_mode) ActKey( wheelbrake );" ),									// I - [WHDN] release wheel brake (DX12)
							   			speedbrakes_close );															// O - Close Speed Brakes


	// China Hat
	// CHF
	MapKeyIO(&Throttle, CHF, 			brightness_up, 																	// I - brightness up (HUD/HMCS/Reticle - Flashlight - NVG)
							 			chinahat_fwd ); 																// O - Radar Elevation Antenna Control - CW/Up
	// CHB
	MapKeyIO(&Throttle, CHB, 			brightness_down,																// I - brightness down (HUD/HMCS/Reticle - Flashlight - NVG)
							 			chinahat_back ); 																// O - Radar Elevation Antenna Control - CCW/Down


	// Pinky Switch (exterior lighting)
	// PSF
	MapKeyIO(&Throttle, PSF,			extlight_flashsteady, 															// I - Exterior lights flash/steady toggle
										extlight_full );	 															// O - Exterior Lights Full
	MapKeyRIO(&Throttle, PSF, 			0,																				// I - 
										extlight_position );															// O - Exterior Lights Position
	// PSB
	MapKey(&Throttle, PSB, 				extlight_covert );			 													// Exterior Lights Covert
	MapKeyR(&Throttle, PSB, 			extlight_position );															// Exterior Lights Position


	// SC (IR/VR re-centre, Discord mute)
	MapKeyIO(&Throttle, SC, 			TEMPO( recentre_irvr,															// I - re-centre IR tracker / VR helmet
											   discord_mute, 500 ),														//     [long] discord mute toggle
										SC_short );																		// O - specified per airplane

								
	// APUON (APU & Air Refuel)
	MapKeyIO(&Throttle, APUON, 			CHAIN( airrefuel_open, D(), AAR_mode_on, D(), throttle_led5_on ),				// I - AIR REFUEL Switch - OPEN; AAR_mode on; LED5 ON for Aerial Refuelling
										apu_on );																		// O - APU on
	MapKeyRIO(&Throttle, APUON, 		CHAIN( airrefuel_close, D(), AAR_mode_off, D(), throttle_led5_off ),			// I - AIR REFUEL Switch - CLOSE; AAR_mode off; LED5 OFF for Aerial Refuelling
										apu_off );																		// O - APU off
	// APUOFF
	MapKey(&Throttle, APUOFF, 			0 );																			//


	// LDGH (Master Caution, VR_mode)
	MapKeyIO(&Throttle, LDGH, 			TEMPO( ingamechat_toggle,														// I - Toggle in-game chat
											   VR_mode_toggle, 500),													//     [long] Switch VR mode on/off
										TEMPO( LDGH_short, 																// O - A/C specific function
											   mastercaution, 500 ));													//	   [long] Master Caution Button


	// Engine Override Left (Front/Back seat, manual pitch override)
	// EFLNORM
	MapKeyIO(&Throttle, EFLNORM, 		CHAIN( 0, D(), throttle_led5_off ), 											// I - Attitude control override switch - NORM; LED5 OFF for MANUAL PITCH Override
										0 );																			// O - (Front seat)
	// EFLOVER   ----   PULSE of niet?????   check - F-5/16 niet
	MapKeyIO(&Throttle, EFLOVER, 		CHAIN( attcontrol_override, D(), throttle_led5_on ),							// I - Attitude control override switch - OVRD; LED5 ON for MANUAL PITCH Override
										0 );																			// O - (Back seat)
	MapKeyR(&Throttle, EFLOVER, 		0 );																			// 

	// Engine Override Right (Hook & Drag Chute)
	// EFRNORM
	MapKeyIO(&Throttle, EFRNORM, 		0, 																				// I - 
										0 );																			// O - 
	// EFROVER
	MapKeyIOUMD(&Throttle, EFROVER, 	0,																				// IU - 
										0,																				// OU - 
										dragchute_deploy,																// IM - Drag Chute deploy
										hook_extend,																	// OM - HOOK Switch - DOWN
										0,																				// ID - 
										0 );																			// OD - 
	MapKeyRIOUMD(&Throttle, EFROVER, 	0,																				// IU -
										0,																				// OU - 
										dragchute_release,																// IM - Drag Chute release
										hook_retract,																	// OM - HOOK Switch - UP
										0,																				// ID - 
										0 );																			// OD - 

	// Engine Operation (Engine idle, start-up sequence, groundcrew, afterburner detent)
	// EOLIGN
	MapKeyIO(&Throttle, EOLIGN,			startup,																		// I - Start-up sequence
										throttle_left_idle );															// O - Left Throttle - IDLE
	// EOLNORM
	MapKey(&Throttle, EOLNORM, 			0 );																			//
	// EOLMOTOR
	MapKeyIO(&Throttle, EOLMOTOR, 		0,																				// I - 
										groundcrew ); 																	// O - Groundcrew steps

	// EORIGN
	MapKeyIO(&Throttle, EORIGN,			0,																				// I - 
										throttle_right_idle );															// O - Right Throttle - IDLE
	// EORNORM
	MapKey(&Throttle, EORNORM, 			0 );																			// 
	// EORMOTOR
	MapKeyIO(&Throttle, EORMOTOR, 		0,																				// I - 
										EXEC( "afterburnerdetent_present = 1;" 											// O - Engage afterburner detent
											  "afterburnerdetent(1);" ));
	MapKeyRIO(&Throttle, EORMOTOR, 		0,																				// I - 
										EXEC( "afterburnerdetent_present = 0;" 											// O - Disengage afterburner detent
											  "afterburnerdetent(0);" ));


	// Engine idle/off
	// IDLELON
	MapKey(&Throttle, IDLELON, 			throttle_left_off );															// Throttle Left - OFF
	MapKeyR(&Throttle, IDLELON, 		throttle_left_idle );															// Throttle Left - IDLE
	// IDLERON
	MapKey(&Throttle, IDLERON, 			CHAIN( D(100), throttle_right_off ));											// Throttle Right - OFF      --- why 100ms delay? key commands at the same time?
	MapKeyR(&Throttle, IDLERON, 		CHAIN( D(100), throttle_right_idle ));											// Throttle Right - IDLE


	// THR_LEFT
	MapAxis(&Throttle, THR_LEFT, DX_ZROT_AXIS, AXIS_NORMAL, MAP_ABSOLUTE);
	SetSCurve(&Throttle, THR_LEFT, 0, 0, 0, 0, 0);
	// THR_RIGHT
	MapAxis(&Throttle, THR_RIGHT, DX_Z_AXIS, AXIS_NORMAL, MAP_ABSOLUTE);
	SetSCurve(&Throttle, THR_RIGHT, 0, 0, 0, 0, 0);
	// THR_FC
	MapAxis(&Throttle, THR_FC, DX_SLIDER_AXIS, AXIS_NORMAL, MAP_ABSOLUTE);
	SetSCurve(&Throttle, THR_FC, 0, 0, 0, 0, 0);
	// SCX
	MapAxis(&Throttle, SCX, DX_XROT_AXIS, AXIS_NORMAL, MAP_ABSOLUTE);													// RDR CURSOR Switch - X axis
	SetSCurve(&Throttle, SCX, 0, 0, 0, 0, 0);
	// SCY
	MapAxis(&Throttle, SCY, DX_YROT_AXIS, AXIS_NORMAL, MAP_ABSOLUTE);													// RDR CURSOR Switch - Y axis
	SetSCurve(&Throttle, SCY, 0, 0, 0, 0, 0);



	// --------- also load SWITCH part of COMMON controls -----------
	
	dcs_fighter_common_switch();																						// controls to be switched back after JESTER use


}	// =====  end dcs_fighter_common_controls()	 ==================================================




// ------------- COMMON SWITCH CONTROLS to be switched back after JESTER use ----------------------

int dcs_fighter_common_switch()
{
	
	// Target Management Switch
	// H2U
	MapKeyIO(&AVA_F16, H2U, 	EXEC( "if (VR_mode) ActKey ( KEYON+vrzoom_in );"										// I - VR zoom in
									  "else ActKey ( KEYON+zoom_in );" ),												//     TrackIR zoom in slow (KP*)
								TMS_fwd );																				// O - TMS fwd
	MapKeyRIO(&AVA_F16, H2U, 	EXEC( "if (VR_mode) ActKey ( vrzoom_in );"												// I - Release vrzoom_in
									  "else ActKey ( zoom_in );" ),														// 	   Release zoom_in
								0 );																					// O - 
	// H2D
	MapKeyIO(&AVA_F16, H2D, 	EXEC( "if (VR_mode) ActKey ( PULSE+KEYON+L_ALT+'c' );"									// I - VR toggle mouse pointer
									  "else ActKey ( KEYON+zoom_out );" ),												// 	   TrackIR zoom out slow (KP\)
								TMS_aft ); 																				// O - TMS aft
	MapKeyRIO(&AVA_F16, H2D, 	EXEC( "if (VR_mode) ActKey ( 0 );"														// I - 
									  "else ActKey ( zoom_out );" ),													// 	   Release zoom_out
								0 );																					// O - 
	// H2R							
	MapKeyIO(&AVA_F16, H2R, 	EXEC( "if (VR_mode) ActKey ( KEYON+mouseclick_right );"									// I - VR Right mouse click
									  "else ActKey ( KEYON+snapview_right );" ),										// 	   TrackIR snap view right (LWIN+KP6)
								TMS_right ); 																			// O - TMS right
	MapKeyRIO(&AVA_F16, H2R, 	EXEC( "if (VR_mode) ActKey ( mouseclick_right );"										// I - Release mouseclick_right
									  "else ActKey ( snapview_right );" ),												// 	   Release snapview_right
								0 );																					// O - 
	// H2L
	MapKeyIO(&AVA_F16, H2L, 	EXEC( "if (VR_mode) ActKey ( KEYON+mouseclick_left );"									// I - VR Left mouse click
									  "else ActKey ( KEYON+snapview_left );" ),											// 	   TrackIR snap view left (LWIN+KP4)
								TMS_left );																				// O - TMS left
	MapKeyRIO(&AVA_F16, H2L, 	EXEC( "if (VR_mode) ActKey ( mouseclick_left );"										// I - Release mouseclick_left
									  "else ActKey ( snapview_left );" ),												// 	   Release snapview_left
								0 );																					// O - 


	// Display Management Switch
	// H3U
	MapKeyIO(&AVA_F16, H3U, 	TEMPO( kneeboard_toggle,																// I - kneeboard on/off
									   nightvision_toggle, 500 ),														// 	   [long] Night Vision Goggles toggle
								DMS_fwd );																				// O - DMS fwd
	// H3D
	MapKeyIO(&AVA_F16, H3D, 	TEMPO( kneeboard_mark,																	// I - kneeboard current position mark point
									   flashlight_toggle, 500 ),														//	   [long] Flashlight on/off
								DMS_aft );																				// O - DMS aft
	// H3R
	MapKeyIO(&AVA_F16, H3R, 	TEMPO( kneeboard_nextpage, 																// I - kneeboard next page
									   kneeboard_nextshcut, 500 ),														//	   [long] Kneeboard Next Shortcut
								DMS_right );																			// O - DMS right
	// H3L
	MapKeyIO(&AVA_F16, H3L, 	TEMPO( kneeboard_prevpage, 																// I - kneeboard previous page
									   kneeboard_prevshcut, 500 ),														//	   [long] Kneeboard Previous Shortcut
								DMS_left );																				// O - DMS left


	// MIC Switch (Transmit Switch)
	// MSU
	MapKeyIOUMD(&Throttle, MSU, TEMPO( EXEC( "if (COMM_mode == 0) ActKey( PULSE+KEYON+flight_engagebandits );"					// IU - [AI comms] Flight - Engage Bandits
											 "else if (COMM_mode == 1) ActKey( PULSE+KEYON+0 );" 								//		[Cont comms] 
											 "else if (COMM_mode == 2) ActKey( PULSE+KEYON+hbcw_picture_declare );" ),			//		[HBCW comms] EWR System Declare
									   EXEC( "if (COMM_mode == 0) ActKey( PULSE+KEYON+flight_pincerright );" ),					// 		[long] [AI comms] Flight - Pincer Right
									   500 ),																					//
								radio1_voip,																					// OU - Transmit Switch - Radio 1 (VOIP)
								TEMPO( EXEC( "if (CAR_mode) ActKey( PULSE+KEYON+cv_requestlaunch );" 							// IM - [CAR]  Request Catapult Launch
											 "else if (WHDN_mode) ActKey( PULSE+KEYON+atc_requeststartup );" 					//		[WHDN] Request Engine Start
											 "else if (AAR_mode) ActKey( PULSE+KEYON+0 );"										//		[AAR]  -
											 "else if (COMM_mode == 0) ActKey( PULSE+KEYON+flight_rejoinformation );"			//		[AI comms] Flight - Rejoin Formation
											 "else if (COMM_mode == 1) ActKey( 0 );" 											//		[Cont comms] 
											 "else if (COMM_mode == 2) ActKey( PULSE+KEYON+hbcw_picture_declare );" ),			//		[HBCW comms] EWR System Declare
									   EXEC( "if (CAR_mode) ActKey( PULSE+KEYON+0 );" 											// 		[long] [CAR]  -
											 "else if (WHDN_mode) ActKey( PULSE+KEYON+0 );"										//		[long] [WHDN] -
											 "else if (AAR_mode) ActKey( PULSE+KEYON+0 );"										//		[long] [AAR]  -
											 "else if (COMM_mode == 0) ActKey( PULSE+KEYON+flight_opencloseformation );" ), 	//		[long] [AI comms] Flight - Open/Close Formation
									   500 ),																					//
								radio1_voip,																					// OM - Transmit Switch - Radio 1 (VOIP)
								TEMPO( EXEC( "if (COMM_mode == 0) ActKey( PULSE+KEYON+flight_attackgroundtargets );"			// ID - [AI comms] Flight - Attack ground targets
											 "else if (COMM_mode == 1) ActKey( PULSE+KEYON+0 );" 								//		[Cont comms] 
											 "else if (COMM_mode == 2) ActKey( PULSE+KEYON+hbcw_picture_declare );" ),			//		[HBCW comms] EWR System Declare
									   EXEC( "if (COMM_mode == 0) ActKey( PULSE+KEYON+flight_attackairdefences );" ),			// 		[long] [AI comms] Flight - Attack air defences
									   500 ),																					//
								radio1_voip );																					// OD - Transmit Switch - Radio 1 (VOIP)
	// MSD
	MapKeyIOUMD(&Throttle, MSD, TEMPO( EXEC( "if (COMM_mode == 0) ActKey( PULSE+KEYON+flight_completemissionrejoin );"			// IU - [AI comms] Flight - Complete mission and rejoin
											 "else if (COMM_mode == 1) ActKey( PULSE+KEYON+0 );" 								//		[Cont comms] 
											 "else if (COMM_mode == 2) ActKey( PULSE+KEYON+0 );" ),								//		[HBCW comms] 
									   EXEC( "if (COMM_mode == 0) ActKey( PULSE+KEYON+flight_coverme );" ),						// 		[long] [AI comms] Flight - Cover Me
									   500 ),																					//
								radio2_voip,																					// OU - Transmit Switch - Radio 2 (VOIP)
								TEMPO( EXEC( "if (CAR_mode) ActKey( PULSE+KEYON+cv_inbound );" 									// IM - [CAR] CV Inbound / See you at 10
											 "else if (WHDN_mode) ActKey( PULSE+KEYON+ground_dtceditor );" 						//		[WHDN] DTC editor
											 "else if (AAR_mode) ActKey( PULSE+KEYON+tanker_inbound );"							//		[AAR] Tanker Inbound
											 "else ActKey( PULSE+KEYON+atc_inbound );" ),										//		[AI comms] ATC - Inbound
									   EXEC( "if (CAR_mode) ActKey( PULSE+KEYON+0 );" 											// 		[long] [CAR]  -
											 "else if (WHDN_mode) ActKey( PULSE+KEYON+0 );" 									//		[long] [WHDN] -
											 "else if (AAR_mode) ActKey( PULSE+KEYON+0 );"										//		[long] [AAR]  -
											 "else if (COMM_mode == 0) ActKey( PULSE+KEYON+flight_rtb );" ),						//		[long] [AI comms] Flight - RTB
									   500 ),																					//
								radio2_voip,																					// OM - Transmit Switch - Radio 2 (VOIP)
								TEMPO( EXEC( "if (COMM_mode == 0) ActKey( PULSE+KEYON+flight_completemissionrejoin );"			// ID - [AI comms] Flight - Complete mission and rejoin
											 "else if (COMM_mode == 1) ActKey( PULSE+KEYON+0 );" 								//		[Cont comms] 
											 "else if (COMM_mode == 2) ActKey( PULSE+KEYON+0 );" ),								//		[HBCW comms] 
									   EXEC( "if (COMM_mode == 0) ActKey( PULSE+KEYON+0 );" ),									// 		[long] [AI comms] 
									   500 ),																					//
								radio2_voip );																					// OD - Transmit Switch - Radio 2 (VOIP)
	// MSR
	MapKeyIOUMD(&Throttle, MSR, TEMPO( EXEC( "if (COMM_mode == 0) ActKey( PULSE+KEYON+flight_spreadfour );"						// IU - [AI comms] Flight - Formation Spread Four
											 "else if (COMM_mode == 1) ActKey( PULSE+KEYON+cont_picture_enemy );" 				//		[Cont comms] EW radar enemy picture
											 "else if (COMM_mode == 2) ActKey( PULSE+KEYON+hbcw_picture_enemy );" ),			//		[HBCW comms] EWR system enemy picture
									   EXEC( "if (COMM_mode == 0) ActKey( PULSE+KEYON+flight_lineabreast );" ),					// 		[long] [AI comms] Flight - Formation Line Abreast
									   500 ),																					//
								radio3_acspecific,																				// OU - Radio 3 - A/C specific function
								TEMPO( EXEC( "if (CAR_mode) ActKey( PULSE+KEYON+cv_salute );" 									// IM - [CAR] CV Salute
											 "else if (WHDN_mode) ActKey( PULSE+KEYON+atc_requesttaxitakeoff );" 				//		[WHDN] Request taxi, take-off (short menu)
											 "else if (AAR_mode) ActKey( PULSE+KEYON+tanker_precontact );"						//		[AAR]  Tanker "Ready for precontact" radio call
											 "else if (COMM_mode == 0) ActKey( PULSE+KEYON+flight_fingerfour );"				//		[AI comms] Flight - Finger Four
											 "else if (COMM_mode == 1) ActKey( PULSE+KEYON+cont_picture_enemy );"				//		[Cont comms] EW radar enemy picture
											 "else if (COMM_mode == 2) ActKey( PULSE+KEYON+hbcw_picture_enemy );" ),			//		[HBCW comms] EWR system enemy picture
									   EXEC( "if (CAR_mode) ActKey( PULSE+KEYON+0 );" 											// 		[long] [CAR]  -
											 "else if (WHDN_mode) ActKey( PULSE+KEYON+0 );" 									//		[long] [WHDN] - 
											 "else if (AAR_mode) ActKey( PULSE+KEYON+0 );"										//		[long] [AAR]  -
											 "else if (COMM_mode == 0) ActKey( PULSE+KEYON+flight_echelonright );" ),			//		[long] [AI comms] Flight - Formation Echelon Right
									   500 ),																					//
								radio3_acspecific,																				// OM - Radio 3 - A/C specific function
								TEMPO( EXEC( "if (COMM_mode == 0) ActKey( PULSE+KEYON+flight_trail );"							// ID - [AI comms] Flight - Formation Trail
											 "else if (COMM_mode == 1) ActKey( PULSE+KEYON+cont_picture_enemy );"				//		[Cont comms] EW radar enemy picture
											 "else if (COMM_mode == 2) ActKey( PULSE+KEYON+hbcw_picture_enemy );" ),			//		[HBCW comms] EWR system enemy picture
									   EXEC( "if (COMM_mode == 0) ActKey( PULSE+KEYON+flight_lineabreast );" ),					// 		[long] [AI comms] Formation Line Abreast
									   500 ),																					//
								radio3_acspecific );																			// OD - Radio 3 - A/C specific function
	// MSL
	MapKeyIOUMD(&Throttle, MSL, TEMPO( EXEC( "if (COMM_mode == 0) ActKey( PULSE+KEYON+awacs_declare );"							// IU - [AI comms] AWACS Declare
											 "else if (COMM_mode == 1) ActKey( PULSE+KEYON+cont_picture_friend );" 				//		[Cont comms] EW radar friendly picture
											 "else if (COMM_mode == 2) ActKey( PULSE+KEYON+hbcw_picture_friend );" ),			//		[HBCW comms] EWR system friendly picture
									   EXEC( "if (COMM_mode == 0) ActKey( PULSE+KEYON+awacs_requestpicture );" ),				// 		[long] [AI comms] AWACS Request Picture
									   500 ),																					//
								radio4_acspecific,																				// OU - Radio 4 - VOIP Intercom / A/C specific function
								TEMPO( EXEC( "if (CAR_mode) ActKey( PULSE+KEYON+cv_calltheball );" 								// IM - [CAR]  Call the Ball
											 "else if (WHDN_mode) ActKey( PULSE+KEYON+ground_rearmrefuel );" 					//		[WHDN] Rearming and Refueling Window  (L_ALT+')
											 "else if (AAR_mode) ActKey( PULSE+KEYON+awacs_bogeydope );"						//		[AAR]  Request AWACS Bogey Dope
											 "else if (COMM_mode == 0) ActKey( PULSE+KEYON+awacs_declare );"					//		[AI comms] AWACS Declare
											 "else if (COMM_mode == 1) ActKey( PULSE+KEYON+cont_picture_friend );" 				//		[Cont comms] EW radar friendly picture
											 "else if (COMM_mode == 2) ActKey( PULSE+KEYON+hbcw_picture_friend );" ),			//		[HBCW comms] EWR system friendly picture
									   EXEC( "if (CAR_mode) ActKey( PULSE+KEYON+0 );" 											// 		[long] [CAR]  -
											 "else if (WHDN_mode) ActKey( PULSE+KEYON+0 );" 									//		[long] [WHDN] -
											 "else if (AAR_mode) ActKey( PULSE+KEYON+0 );"										//		[long] [AAR]  -
											 "else if (COMM_mode == 0) ActKey( PULSE+KEYON+awacs_requestpicture );" ), 			//		[long] [AI comms] AWACS Request Picture
									   500 ),																					//
								radio4_acspecific,																				// OM - Radio 4 - VOIP Intercom / A/C specific function
								TEMPO( EXEC( "if (COMM_mode == 0) ActKey( PULSE+KEYON+flight_radaroffon );"						// ID - [AI comms] Flight - Radar Off/On
											 "else if (COMM_mode == 1) ActKey( PULSE+KEYON+cont_picture_friend );" 				//		[Cont comms] EW radar friendly picture
											 "else if (COMM_mode == 2) ActKey( PULSE+KEYON+hbcw_picture_friend );" ),			//		[HBCW comms] EWR system friendly picture
									   EXEC( "if (COMM_mode == 0) ActKey( PULSE+KEYON+awacs_requestpicture );" ),				// 		[long] [AI comms] AWACS Request Picture
									   500 ),																					//
								radio4_acspecific );																			// OD - Radio 4 - VOIP Intercom / A/C specific function
	// MSP 
	MapKeyIO(&Throttle, MSP, 	radiomenu_exit,																					// I - F12 exit radio menu
								radiomenu );			 																		// O - Radio menu


}	// end dcs_fighter_common_switch()	===========================================================




// -------------------- LEFT MFD controls ---------------------------------------------------------

int dcs_fighter_common_mfd()
{

	MapKeyIO(&LMFD, SYMU, 		CHAIN( R_WIN+R_SHIFT, D(10), 'o' ), 											// I - Right MFD SYM Up
								CHAIN( R_WIN+L_SHIFT, D(10), 'o' ));											// O - Left MFD SYM Up

	MapKeyIO(&LMFD, SYMD, 		CHAIN( R_WIN+R_SHIFT, D(10), 'k' ), 											// I - Right MFD SYM Down
								CHAIN( R_WIN+L_SHIFT, D(10), 'k' ));											// O - Left MFD SYM Down

	MapKeyIO(&LMFD, CONU, 		CHAIN( R_WIN+R_SHIFT, D(10), 'i' ), 											// I - Right MFD CON Up
								CHAIN( R_WIN+L_SHIFT, D(10), 'i' ));											// O - Left MFD CON Up

	MapKeyIO(&LMFD, COND, 		CHAIN( R_WIN+R_SHIFT, D(10), 'j' ), 											// I - Right MFD CON Down
								CHAIN( R_WIN+L_SHIFT, D(10), 'j' ));											// O - Left MFD CON Down

	MapKeyIO(&LMFD, BRTU, 		CHAIN( R_WIN+R_SHIFT, D(10), 'u' ), 											// I - Right MFD BRT Up
								CHAIN( R_WIN+L_SHIFT, D(10), 'u' ));											// O - Left MFD BRT Up

	MapKeyIO(&LMFD, BRTD, 		CHAIN( R_WIN+R_SHIFT, D(10), 'h' ), 											// I - Right MFD BRT Down
								CHAIN( R_WIN+L_SHIFT, D(10), 'h' ));											// O - Left MFD BRT Down

	MapKeyIO(&LMFD, GAINU, 		CHAIN( R_WIN+R_SHIFT, D(10), 'y' ), 											// I - Right MFD GAIN Up
								CHAIN( R_WIN+L_SHIFT, D(10), 'y' ));											// O - Left MFD GAIN Up

	MapKeyIO(&LMFD, GAIND, 		CHAIN( R_WIN+R_SHIFT, D(10), 'g' ), 											// I - Right MFD GAIN Down
								CHAIN( R_WIN+L_SHIFT, D(10), 'g' ));											// O - Left MFD GAIN Down

	MapKeyIO(&LMFD, OSB01, 		CHAIN( R_WIN+R_SHIFT, D(10), '1' ), 											// I - Right MFD OSB 01
								CHAIN( R_WIN+L_SHIFT, D(10), '1' ));											// O - Left MFD OSB 01

	MapKeyIO(&LMFD, OSB02, 		CHAIN( R_WIN+R_SHIFT, D(10), '2' ), 											// I - Right MFD OSB 02
								CHAIN( R_WIN+L_SHIFT, D(10), '2' ));											// O - Left MFD OSB 02

	MapKeyIO(&LMFD, OSB03, 		CHAIN( R_WIN+R_SHIFT, D(10), '3' ), 											// I - Right MFD OSB 03
								CHAIN( R_WIN+L_SHIFT, D(10), '3' ));											// O - Left MFD OSB 03

	MapKeyIO(&LMFD, OSB04, 		CHAIN( R_WIN+R_SHIFT, D(10), '4' ), 											// I - Right MFD OSB 04
								CHAIN( R_WIN+L_SHIFT, D(10), '4' ));											// O - Left MFD OSB 04

	MapKeyIO(&LMFD, OSB05, 		CHAIN( R_WIN+R_SHIFT, D(10), '5' ), 											// I - Right MFD OSB 05
								CHAIN( R_WIN+L_SHIFT, D(10), '5' ));											// O - Left MFD OSB 05

	MapKeyIO(&LMFD, OSB06, 		CHAIN( R_WIN+R_SHIFT, D(10), '6' ), 											// I - Right MFD OSB 06
								CHAIN( R_WIN+L_SHIFT, D(10), '6' ));											// O - Left MFD OSB 06

	MapKeyIO(&LMFD, OSB07, 		CHAIN( R_WIN+R_SHIFT, D(10), '7' ), 											// I - Right MFD OSB 07
								CHAIN( R_WIN+L_SHIFT, D(10), '7' ));											// O - Left MFD OSB 07

	MapKeyIO(&LMFD, OSB08, 		CHAIN( R_WIN+R_SHIFT, D(10), '8' ), 											// I - Right MFD OSB 08
								CHAIN( R_WIN+L_SHIFT, D(10), '8' ));											// O - Left MFD OSB 08

	MapKeyIO(&LMFD, OSB09, 		CHAIN( R_WIN+R_SHIFT, D(10), '9' ), 											// I - Right MFD OSB 09
								CHAIN( R_WIN+L_SHIFT, D(10), '9' ));											// O - Left MFD OSB 09

	MapKeyIO(&LMFD, OSB10, 		CHAIN( R_WIN+R_SHIFT, D(10), '0' ), 											// I - Right MFD OSB 10
								CHAIN( R_WIN+L_SHIFT, D(10), '0' ));											// O - Left MFD OSB 10

	MapKeyIO(&LMFD, OSB11, 		CHAIN( R_WIN+R_CTL, D(10), '1' ),												// I - Right MFD OSB 11
								CHAIN( R_WIN+L_CTL, D(10), '1' ));												// O - Left MFD OSB 11

	MapKeyIO(&LMFD, OSB12, 		CHAIN( R_WIN+R_CTL, D(10), '2' ), 												// I - Right MFD OSB 12
								CHAIN( R_WIN+L_CTL, D(10), '2' ));												// O - Left MFD OSB 12

	MapKeyIO(&LMFD, OSB13, 		CHAIN( R_WIN+R_CTL, D(10), '3' ), 												// I - Right MFD OSB 13
								CHAIN( R_WIN+L_CTL, D(10), '3' ));												// O - Left MFD OSB 13

	MapKeyIO(&LMFD, OSB14, 		CHAIN( R_WIN+R_CTL, D(10), '4' ), 												// I - Right MFD OSB 14
								CHAIN( R_WIN+L_CTL, D(10), '4' ));												// O - Left MFD OSB 14

	MapKeyIO(&LMFD, OSB15, 		CHAIN( R_WIN+R_CTL, D(10), '5' ), 												// I - Right MFD OSB 15
								CHAIN( R_WIN+L_CTL, D(10), '5' ));												// O - Left MFD OSB 15

	MapKeyIO(&LMFD, OSB16, 		CHAIN( R_WIN+R_CTL, D(10), '6' ), 												// I - Right MFD OSB 16
								CHAIN( R_WIN+L_CTL, D(10), '6' ));												// O - Left MFD OSB 16

	MapKeyIO(&LMFD, OSB17, 		CHAIN( R_WIN+R_CTL, D(10), '7' ), 												// I - Right MFD OSB 17
								CHAIN( R_WIN+L_CTL, D(10), '7' ));												// O - Left MFD OSB 17

	MapKeyIO(&LMFD, OSB18, 		CHAIN( R_WIN+R_CTL, D(10), '8' ), 												// I - Right MFD OSB 18
								CHAIN( R_WIN+L_CTL, D(10), '8' ));												// O - Left MFD OSB 18

	MapKeyIO(&LMFD, OSB19, 		CHAIN( R_WIN+R_CTL, D(10), '9' ), 												// I - Right MFD OSB 19
								CHAIN( R_WIN+L_CTL, D(10), '9' ));												// O - Left MFD OSB 19

	MapKeyIO(&LMFD, OSB20, 		CHAIN( R_WIN+R_CTL, D(10), '0' ), 												// I - Right MFD OSB 20
								CHAIN( R_WIN+L_CTL, D(10), '0' ));												// O - Left MFD OSB 20



}	// =====  end dcs_fighter_common_mfd()  ==============================================================