include "DCS_F-14_Tomcat_JESTER.tmc"						// JESTER controls
include "DCS_Fighter_Common.tmc"							// DCS fighter COMMON controls




// ------------------------- INITIALISE -----------------------------

int autopilot;
int extlight_posdim;	

int displaymode_takeoff;
int	displaymode_cruise;
int	displaymode_a2a;
int	displaymode_a2g;
int displaymode_land;
int displaymode_next;
int displaymode_prev;
int displaymode_whdn;
int hudtrim_incr;
int hudtrim_decr;
int	wingsweep_fwd;
int	wingsweep_aft;
int	wingsweep_bomb;
int	wingsweep_auto;
int	acmcover_open;
int	acmcover_close;
int	acmcover_toggle;
int missilemode_toggle;
int	tgtdes_vsl_hi;
int	tgtdes_vsl_lo;
int	pal;
int	plm;
int	dlcthumb_fwd;
int	dlcthumb_aft;
int fcsstab_roll_on;
int fcsstab_roll_off;
int fcsstab_roll_toggle;
int flaps_up;
int flaps_down;
int autothrottle;
int	bombing_tool;
int	checklist_tool;
int	virt_browser;
int	manual_toggle;
int horns_left;
int horns_right;

int steercmdlist, index_stcmd = 0;							// (start with second element after increment, element 0 is first element in list)
int radarrangelist, index_range = 2;						// (current is middle of five (assumption 100 nm), element 2, element 0 is first element in list)
int steerpointlist_aa, index_stpt_aa = -1;					// (start with first element after increment, wp1, element 0 is first element in list)
int steerpointlist_ag, index_stpt_ag = -1;					// (start with first element after increment, wp1, element 0 is first element in list)

int	JSTR_rdr_mode_auto;
int	JSTR_rdr_mode_TWS;
int	JSTR_rdr_mode_RWS;
int	JSTR_toggle_PD_P_STT;
int	JSTR_rdr_off;
int	JSTR_rdr_on;
int	JSTR_rdr_range_auto;
int	JSTR_rdr_range_25;
int	JSTR_rdr_range_50;
int	JSTR_rdr_range_100;
int	JSTR_rdr_range_200;
int	JSTR_rdr_range_400;
int	JSTR_rdr_ac_stab;
int	JSTR_rdr_ground_stab;

int	JSTR_lock_enemy_ahead;
int	JSTR_lock_friend_ahead;
int	JSTR_lock_tgt_ahead;
int	JSTR_break_lock;
int	JSTR_lock_TWS_tgt_1;
int	JSTR_lock_TWS_tgt_2;

int	JSTR_rwr_norm;
int	JSTR_rwr_ai;
int	JSTR_rwr_aaa;
int JSTR_rwr_unknown;

int	JSTR_nav_wp1;
int	JSTR_nav_wp2;
int	JSTR_nav_wp3;
int	JSTR_nav_ip;
int	JSTR_nav_surftgt;
int	JSTR_nav_homebase;
int	JSTR_nav_fixpt;

int	JSTR_lntrn_q_wp1;
int	JSTR_lntrn_q_wp2;
int	JSTR_lntrn_q_wp3;
int	JSTR_lntrn_q_ip;
int	JSTR_lntrn_q_surftgt;
int JSTR_lntrn_designate;
int JSTR_lntrn_undesignate;
int JSTR_lntrn_stblarea;
int JSTR_lntrn_srch_anyactive;
int JSTR_lntrn_srch_aircraftall;
int JSTR_lntrn_srch_samactive;
int JSTR_lntrn_srch_armoractive;
int JSTR_lntrn_nexttgt;
int JSTR_lntrn_prevtgt;
int JSTR_lntrn_bwhot_tggl;

int	JSTR_startup;
int	JSTR_loudclear;
int	JSTR_ins_fine;
int	JSTR_ins_wpn;
int	JSTR_jett_droptanks;
int	JSTR_jammer_onoff;
int	JSTR_spot;
int	JSTR_check;

int JSTR_menu;
int JSTR_context;
int	JSTR_context_short;
int	JSTR_context_long;
int	JSTR_context_double;

int JSTR_toggle_RWS_TWS;
int JSTR_ground_ac_stbl;
int JSTR_rdr_offon;
int JSTR_rwr_ai_norm;
int JSTR_rwr_unknown_norm;
int JSTR_WHDN_startup;
int	JSTR_nav_wp123;

int	Steer_CMD_TACAN;
int	Steer_CMD_Destination;
int	Steer_CMD_AWLPCD;
int	Steer_CMD_VEC;
int	Steer_CMD_MAN;


define AB 75											// detent position at AB% of full throttle reach (80% for F-14B, 75% for F-14A)




// ------------------------------ MAIN F-14 -------------------------------------------------------

int main()
{
	// ------------------ COMMON CONFIGURATION ----------------------
					
	dcs_fighter_common_configuration();					// load dcs COMMON config
	

	// -------------------- COMMON FUNCTIONS ------------------------
					
	dcs_fighter_common_functions();						// load dcs COMMON functions


	// -------------------- AIRCRAFT FUNCTIONS ----------------------


	// ------------------------- FUNCTIONS --------------------------


	// Keybindings
	displaymode_takeoff	= CHAIN( DOWN+L_SHIFT, D(10), PULSE+'1', D(), UP+L_SHIFT );
	displaymode_cruise	= CHAIN( DOWN+L_SHIFT, D(10), PULSE+'2', D(), UP+L_SHIFT );
	displaymode_a2a		= CHAIN( DOWN+L_SHIFT, D(10), PULSE+'3', D(), UP+L_SHIFT );
	displaymode_a2g		= CHAIN( DOWN+L_SHIFT, D(10), PULSE+'4', D(), UP+L_SHIFT );
	displaymode_land	= CHAIN( DOWN+L_SHIFT, D(10), PULSE+'5', D(), UP+L_SHIFT );
	displaymode_prev	= CHAIN( DOWN+L_SHIFT, D(10), PULSE+'6', D(), UP+L_SHIFT );
	displaymode_next	= CHAIN( DOWN+L_SHIFT, D(10), PULSE+'7', D(), UP+L_SHIFT );
	displaymode_whdn	= EXEC( "if (WHDN_mode) ActKey(PULSE+KEYON+displaymode_land);"
								"else ActKey(PULSE+KEYON+displaymode_cruise);" );
	wingsweep_fwd		= CHAIN( L_ALT, D(10), 'w' );
	wingsweep_aft		= CHAIN( L_SHIFT+R_CTL, D(10), 'w' );
	wingsweep_bomb		= CHAIN( DOWN+L_CTL+R_CTL, D(10), PULSE+'w', D(), UP+L_CTL+R_CTL );
	wingsweep_auto		= CHAIN( DOWN+L_CTL+R_SHIFT, D(10), PULSE+'w', D(), UP+L_CTL+R_SHIFT );
	acmcover_open		= CHAIN( DOWN+R_SHIFT+L_ALT, D(10), PULSE+'c', D(), UP+R_SHIFT+L_ALT );
	acmcover_close		= CHAIN( DOWN+R_SHIFT+L_CTL, D(10), PULSE+'c', D(), UP+R_SHIFT+L_CTL );
	acmcover_toggle		= CHAIN( DOWN+R_SHIFT+L_SHIFT, D(10), PULSE+'c', D(), UP+R_SHIFT+L_SHIFT );
	missilemode_toggle	= CHAIN( DOWN+L_CTL, D(10), PULSE+'p', D(), UP+L_CTL );
	tgtdes_vsl_hi		= CHAIN( R_SHIFT+L_SHIFT, D(10), 't' );
	tgtdes_vsl_lo		= CHAIN( R_SHIFT+L_CTL, D(10), 't' );
	pal					= CHAIN( DOWN+R_SHIFT+L_ALT, D(10), PULSE+'t', D(), UP+R_SHIFT+L_ALT );
	plm					= CHAIN( L_SHIFT+L_CTL, D(10), 't' );
	dlcthumb_fwd		= CHAIN( L_SHIFT, D(10), 'd' );
	dlcthumb_aft		= CHAIN( L_CTL, D(10), 'd' );
	fcsstab_roll_on		= CHAIN( DOWN+R_CTL+L_SHIFT, D(10), PULSE+'r', D(), UP+R_CTL+L_SHIFT );
	fcsstab_roll_off	= CHAIN( DOWN+R_CTL+L_CTL, D(10), PULSE+'r', D(), UP+R_CTL+L_CTL );
	fcsstab_roll_toggle	= CHAIN( DOWN+R_CTL+L_ALT, D(10), PULSE+'r', D(), UP+R_CTL+L_ALT );
	autothrottle		= CHAIN( DOWN+L_CTL, D(10), PULSE+'t', D(), UP+L_CTL );
	flaps_up			= CHAIN( DOWN+L_SHIFT, D(10), PULSE+'f', D(), UP+L_SHIFT );										// Flap Switch - UP
	flaps_down			= PULSE+'f';																					// Flap Switch - DOWN
	bombing_tool		= CHAIN( DOWN+R_CTL, D(10), PULSE+'b', D(), UP+R_CTL );
	checklist_tool		= CHAIN( DOWN+R_CTL, D(10), PULSE+'c', D(), UP+R_CTL );
	virt_browser		= CHAIN( DOWN+R_CTL, D(10), PULSE+'v', D(), UP+R_CTL );
	manual_toggle		= CHAIN( DOWN+R_ALT, D(10), PULSE+'m', D(), UP+R_ALT );
	horns_left			= CHAIN( DOWN+L_SHIFT+L_ALT, D(10), PULSE+'o', D(), UP+L_SHIFT+L_ALT );
	horns_right			= CHAIN( DOWN+R_SHIFT+L_ALT, D(10), PULSE+'o', D(), UP+R_SHIFT+L_ALT );

	// DX bindings
	hudtrim_incr		= DX13;																							// In Common this is bound to radar elevation
	hudtrim_decr		= DX14;																							// In Common this is bound to radar elevation

	// Autopilot
	autopilot 	= SEQ( CHAIN( EXEC( "autopilot_mode();" ), D(200),														// Set autopilot mode
							  DOWN+L_ALT+L_SHIFT, D(10), PULSE+'p', D(), UP+L_ALT+L_SHIFT ),							// Autopilot on
					   CHAIN( DOWN+L_ALT+L_CTL, D(10), PULSE+'p', D(), UP+L_ALT+L_CTL ));								// Autopilot off
	

	// Ground Crew Start-up
	groundcrew	= SEQ( CHAIN( ground_wheelchocks_place, D(10000), 																	// Radio menu (\), Prev menu, Ground crew, Wheel Chocks, Place 
							  ground_elecpower_on, D(13000), 																		// Radio menu (\), Ground crew, Ground Electric Power, On
							  ground_airsupply_connect, D(13000) ),																	// Radio menu (\), Ground crew, Ground Air Supply, Connect
					   CHAIN( ground_airsupply_disconnect, D(13000),																// Radio menu (\), Prev menu, Ground crew, Ground Air Supply, Disconnect
							  ground_elecpower_off, D(13000), 																		// Radio menu (\), Ground crew, Ground Electric Power, Off
							  ground_wheelchocks_remove ));																			// Radio menu (\), Ground crew, Wheel Chocks, Remove

							  
	// DTC editor (overwrite of Common)
	ground_dtceditor	= SEQ( CHAIN( PULSE+USB[0x31], D(200), PULSE+F11, D(200), PULSE+F8, D(200), PULSE+F10, D(200), PULSE+F1 ), 	// Radio menu (\), Prev menu, Ground crew, DTC interface, Show
							   CHAIN( PULSE+USB[0x31], D(200), PULSE+F8, D(200), PULSE+F10, D(200), PULSE+F2 ));					// Radio menu (\), Ground crew, DTC interface, Hide


	// Exterior Lighting - Full
	extlight_full 		= CHAIN( DOWN+L_SHIFT+R_SHIFT, D(10), PULSE+'l', D(), UP+L_SHIFT+R_SHIFT, D(100),				// Lights Anti Collision ON
							     DOWN+L_CTL+R_SHIFT, D(10), PULSE+'l', D(), UP+L_CTL+R_SHIFT, D(100),					// Lights Position Wing BRT
						   		 DOWN+L_ALT+R_SHIFT, D(10), PULSE+'l', D(), UP+L_ALT+R_SHIFT, D(100),					// Lights Position Tail BRT
						   		 PULSE+'l', D(100),																		// Exterior Lights Master Switch ON
						   		 REXEC( 0, 100, "ActKey( PULSE+KEYON+R_CTL+'l' );", RNOSTOP ), 							// Lights Formation Brightnes Down
						   		 D(800),																				// loop 8x
						   		 EXEC( "StopAutoRepeat(0);" ));															// stop loop
	// Exterior Lighting - Position Dim
	extlight_posdim 	= CHAIN( DOWN+L_SHIFT+R_CTL, D(10), PULSE+'l', D(), UP+L_SHIFT+R_CTL, D(100),					// Lights Anti Collision OFF
							 	 DOWN+L_CTL+L_ALT, D(10), PULSE+'l', D(), UP+L_CTL+L_ALT, D(100),						// Lights Position Wing DIM
							 	 DOWN+L_ALT+L_SHIFT, D(10), PULSE+'l', D(), UP+L_ALT+L_SHIFT, D(100),					// Lights Position Tail DIM
								 PULSE+'l', D(100),																		// Exterior Lights Master Switch ON
								 REXEC( 1, 100, "ActKey( PULSE+KEYON+R_CTL+'l' );", RNOSTOP ), 							// Lights Formation Brightnes Down
								 D(800),																				//   loop 8x
								 EXEC( "StopAutoRepeat(1);" ));															//   stop loop
	// Exterior Lighting - Formation
	extlight_formation 	= CHAIN( DOWN+L_SHIFT+R_CTL, D(10), PULSE+'l', D(), UP+L_SHIFT+R_CTL, D(100),					// Lights Anti Collision OFF
								 DOWN+L_CTL+R_CTL, D(10), PULSE+'l', D(), UP+L_CTL+R_CTL, D(100),						// Lights Position Wing OFF
								 DOWN+L_ALT+R_CTL, D(10), PULSE+'l', D(), UP+L_ALT+R_CTL, D(100),						// Lights Position Tail OFF
								 PULSE+'l', D(100),																		// Exterior Lights Master Switch ON
								 REXEC( 2, 100, "ActKey( PULSE+KEYON+R_SHIFT+'l' );", RNOSTOP ), 						// Lights Formation Brightnes Up
								 D(800),																				//   loop 8x
								 EXEC( "StopAutoRepeat(2);" ));															//   stop loop
	// Exterior Lighting - Covert
	extlight_covert 	= CHAIN( DOWN+L_CTL, D(10), PULSE+'l', D(), UP+L_CTL );											// Exterior Lights Master Switch OFF



	// JESTER calls

	// Radar - Radar Mode
	JSTR_rdr_mode_auto		= CHAIN( PULSE+'a', D(200), PULSE+'a', D(200), 												// Main menu
									 DOWN+L_CTL, D(10), PULSE+'2', D(), UP+L_CTL, D(200), 								// Air to air radar
									 DOWN+L_CTL, D(10), PULSE+'1', D(), UP+L_CTL, D(200), 								// Beyond visual range radar
									 DOWN+L_CTL, D(10), PULSE+'5', D(), UP+L_CTL, D(200), 								// Radar settings
									 DOWN+L_CTL, D(10), PULSE+'1', D(), UP+L_CTL );										// Auto radar
	JSTR_rdr_mode_TWS		= CHAIN( DOWN+L_CTL+R_SHIFT, D(10), PULSE+'6', D(), UP+L_CTL+R_SHIFT );
	JSTR_rdr_mode_RWS		= CHAIN( DOWN+L_CTL+R_SHIFT, D(10), PULSE+'7', D(), UP+L_CTL+R_SHIFT );
	JSTR_toggle_PD_P_STT	= CHAIN( DOWN+L_CTL+R_SHIFT, D(10), PULSE+'4', D(), UP+L_CTL+R_SHIFT );
	// Radar - Silent/Active
	JSTR_rdr_off			= CHAIN( PULSE+'a', D(200), PULSE+'a', D(200), 												// Main menu
									 DOWN+L_CTL, D(10), PULSE+'2', D(), UP+L_CTL, D(200), 								// Air to air radar
									 DOWN+L_CTL, D(10), PULSE+'1', D(), UP+L_CTL, D(200), 								// Beyond visual range radar
									 DOWN+L_CTL, D(10), PULSE+'7', D(), UP+L_CTL );										// Radar go silent
	JSTR_rdr_on				= CHAIN( PULSE+'a', D(200), PULSE+'a', D(200), 												// Main menu
									 DOWN+L_CTL, D(10), PULSE+'2', D(), UP+L_CTL, D(200), 								// Air to air radar
									 DOWN+L_CTL, D(10), PULSE+'1', D(), UP+L_CTL, D(200), 								// Beyond visual range radar
									 DOWN+L_CTL, D(10), PULSE+'6', D(), UP+L_CTL );										// Radar go active
	// Radar - Stabilise
	JSTR_rdr_ac_stab		= CHAIN( DOWN+L_CTL+R_SHIFT, D(10), PULSE+'8', D(), UP+L_CTL+R_SHIFT );
	JSTR_rdr_ground_stab	= CHAIN( DOWN+L_CTL+R_SHIFT, D(10), PULSE+'9', D(), UP+L_CTL+R_SHIFT );
	// Radar – STT Lock
	JSTR_lock_enemy_ahead 	= CHAIN( DOWN+L_CTL+R_SHIFT, D(10), PULSE+'1', D(), UP+L_CTL+R_SHIFT );
	JSTR_lock_friend_ahead 	= CHAIN( DOWN+L_CTL+R_SHIFT, D(10), PULSE+'2', D(), UP+L_CTL+R_SHIFT );
	JSTR_lock_tgt_ahead 	= CHAIN( DOWN+L_CTL+R_SHIFT, D(10), PULSE+'3', D(), UP+L_CTL+R_SHIFT );
	JSTR_break_lock			= CHAIN( DOWN+L_CTL+R_SHIFT, D(10), PULSE+'5', D(), UP+L_CTL+R_SHIFT );
	JSTR_lock_TWS_tgt_1		= CHAIN( PULSE+'a', D(200), PULSE+'a', D(200), 												// Main menu
									 DOWN+L_CTL, D(10), PULSE+'2', D(), UP+L_CTL, D(200), 								// Air to air radar
									 DOWN+L_CTL, D(10), PULSE+'1', D(), UP+L_CTL, D(200), 								// Beyond visual range radar
									 DOWN+L_CTL, D(10), PULSE+'1', D(), UP+L_CTL, D(200), 								// STT lock
									 DOWN+L_CTL, D(10), PULSE+'6', D(), UP+L_CTL, D(200), 								// TWS target number
									 DOWN+L_CTL, D(10), PULSE+'1', D(), UP+L_CTL );										// TWS track 1
	JSTR_lock_TWS_tgt_2		= CHAIN( PULSE+'a', D(200), PULSE+'a', D(200), 												// Main menu
									 DOWN+L_CTL, D(10), PULSE+'2', D(), UP+L_CTL, D(200), 								// Air to air radar
									 DOWN+L_CTL, D(10), PULSE+'1', D(), UP+L_CTL, D(200), 								// Beyond visual range radar
									 DOWN+L_CTL, D(10), PULSE+'1', D(), UP+L_CTL, D(200), 								// STT lock
									 DOWN+L_CTL, D(10), PULSE+'6', D(), UP+L_CTL, D(200), 								// TWS target number
									 DOWN+L_CTL, D(10), PULSE+'2', D(), UP+L_CTL );										// TWS track 2

	// RWR F-14AB
	JSTR_rwr_norm			= CHAIN( PULSE+'a', D(200), PULSE+'a', D(200),												// Main menu
									 DOWN+L_CTL, D(10), PULSE+'6', D(), UP+L_CTL, D(200), 								// CMS & RWR
									 DOWN+L_CTL, D(10), PULSE+'6', D(), UP+L_CTL, D(200), 								// RWR display type
									 DOWN+L_CTL, D(10), PULSE+'1', D(), UP+L_CTL ); 									// Normal
	JSTR_rwr_ai				= CHAIN( PULSE+'a', D(200), PULSE+'a', D(200),												// Main menu
									 DOWN+L_CTL, D(10), PULSE+'6', D(), UP+L_CTL, D(200), 								// CMS & RWR
									 DOWN+L_CTL, D(10), PULSE+'6', D(), UP+L_CTL, D(200), 								// RWR display type
									 DOWN+L_CTL, D(10), PULSE+'2', D(), UP+L_CTL );										// AI - Airborne Interceptor
	JSTR_rwr_aaa			= CHAIN( PULSE+'a', D(200), PULSE+'a', D(200),												// Main menu
									 DOWN+L_CTL, D(10), PULSE+'6', D(), UP+L_CTL, D(200), 								// CMS & RWR
									 DOWN+L_CTL, D(10), PULSE+'6', D(), UP+L_CTL, D(200), 								// RWR display type
									 DOWN+L_CTL, D(10), PULSE+'3', D(), UP+L_CTL );										// AAA
	JSTR_rwr_unknown		= CHAIN( PULSE+'a', D(200), PULSE+'a', D(200),												// Main menu
									 DOWN+L_CTL, D(10), PULSE+'6', D(), UP+L_CTL, D(200), 								// CMS & RWR
									 DOWN+L_CTL, D(10), PULSE+'6', D(), UP+L_CTL, D(200), 								// RWR display type
									 DOWN+L_CTL, D(10), PULSE+'4', D(), UP+L_CTL );										// Unknown

	// RWR F-14BU
	JSTR_rwr_norm			= CHAIN( PULSE+'a', D(200), PULSE+'a', D(200),												// Main menu
									 DOWN+L_CTL, D(10), PULSE+'6', D(), UP+L_CTL, D(200), 								// CMS & RWR
									 DOWN+L_CTL, D(10), PULSE+'5', D(), UP+L_CTL, D(200), 								// RWR display type
									 DOWN+L_CTL, D(10), PULSE+'1', D(), UP+L_CTL ); 									// Normal
	JSTR_rwr_ai				= CHAIN( PULSE+'a', D(200), PULSE+'a', D(200),												// Main menu
									 DOWN+L_CTL, D(10), PULSE+'6', D(), UP+L_CTL, D(200), 								// CMS & RWR
									 DOWN+L_CTL, D(10), PULSE+'5', D(), UP+L_CTL, D(200), 								// RWR display type
									 DOWN+L_CTL, D(10), PULSE+'2', D(), UP+L_CTL );										// AI - Airborne Interceptor
	JSTR_rwr_aaa			= CHAIN( PULSE+'a', D(200), PULSE+'a', D(200),												// Main menu
									 DOWN+L_CTL, D(10), PULSE+'6', D(), UP+L_CTL, D(200), 								// CMS & RWR
									 DOWN+L_CTL, D(10), PULSE+'5', D(), UP+L_CTL, D(200), 								// RWR display type
									 DOWN+L_CTL, D(10), PULSE+'3', D(), UP+L_CTL );										// AAA
	JSTR_rwr_unknown		= CHAIN( PULSE+'a', D(200), PULSE+'a', D(200),												// Main menu
									 DOWN+L_CTL, D(10), PULSE+'6', D(), UP+L_CTL, D(200), 								// CMS & RWR
									 DOWN+L_CTL, D(10), PULSE+'5', D(), UP+L_CTL, D(200), 								// RWR display type
									 DOWN+L_CTL, D(10), PULSE+'4', D(), UP+L_CTL );										// Unknown

	// LANTIRN
	JSTR_lntrn_designate		= CHAIN( PULSE+'a', D(200), 
										 DOWN+L_CTL, D(10), PULSE+'7', D(), UP+L_CTL, D(200), 
										 DOWN+L_CTL, D(10), PULSE+'3', D(), UP+L_CTL );
	JSTR_lntrn_undesignate		= CHAIN( PULSE+'a', D(200), 
										 DOWN+L_CTL, D(10), PULSE+'7', D(), UP+L_CTL, D(200), 
										 DOWN+L_CTL, D(10), PULSE+'4', D(), UP+L_CTL );
	JSTR_lntrn_bwhot_tggl		= CHAIN( PULSE+'a', D(200), 
										 DOWN+L_CTL, D(10), PULSE+'7', D(), UP+L_CTL, D(200), 
										 DOWN+L_CTL, D(10), PULSE+'6', D(), UP+L_CTL );
	JSTR_lntrn_stblarea			= CHAIN( PULSE+'a', D(200), 
										 DOWN+L_CTL, D(10), PULSE+'3', D(), UP+L_CTL );
	JSTR_lntrn_srch_anyactive	= CHAIN( PULSE+'a', D(200), 
										 DOWN+L_CTL, D(10), PULSE+'4', D(), UP+L_CTL, D(200), 
										 DOWN+L_CTL, D(10), PULSE+'2', D(), UP+L_CTL );
	JSTR_lntrn_srch_aircraftall	= CHAIN( PULSE+'a', D(200), 
										 DOWN+L_CTL, D(10), PULSE+'4', D(), UP+L_CTL, D(200), 
										 DOWN+L_CTL, D(10), PULSE+'3', D(), UP+L_CTL );
	JSTR_lntrn_srch_samactive	= CHAIN( PULSE+'a', D(200), 
										 DOWN+L_CTL, D(10), PULSE+'4', D(), UP+L_CTL, D(200), 
										 DOWN+L_CTL, D(10), PULSE+'5', D(), UP+L_CTL );
	JSTR_lntrn_srch_armoractive	= CHAIN( PULSE+'a', D(200), 
										 DOWN+L_CTL, D(10), PULSE+'4', D(), UP+L_CTL, D(200), 
