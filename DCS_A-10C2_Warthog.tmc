// DCS A-10C2 Warthog Thrustmaster Warthog/AVA/MFD Script by Astro
// TARGET version 3.0.25.127
// version 3.0, Oct 2026


include "target.tmh"
include "DCS_Fighter_Common.tmc"


// ------------------------ INITIALISE ------------------------------

int mastermode;
int mastermodecontrolbutton;
int mastermode_aa;
int mastermode_nav;
int deferdelay;

int eac_arm;
int ufcrocker_up;
int ufcrocker_down;
int boatswitch_fwd;
int boatswitch_centre;
int boatswitch_aft;
int CMS_fwd;
int CMS_aft;
int CMS_right;
int CMS_left;
int CMS_push;
int coolie_up;
int coolie_down;
int coolie_right;
int coolie_left;
//int chinahat_fwd;
//int chinahat_back;
int ltb_short;
int flaps_up;
int flaps_down;


define AB 100											// detent position at AB% of full throttle reach



// -------------------------- MAIN A-10C2 ---------------------------------------------------------

int main()
{
	// -------------------- COMMON CONFIGURATION --------------------
					
	dcs_fighter_common_configuration();					// load dcs COMMON config
	

	// -------------------- COMMON FUNCTIONS ------------------------
					
	dcs_fighter_common_functions();						// load dcs COMMON functions
	

	// -------------------- AIRCRAFT FUNCTIONS ----------------------

	// Target Management Switch / Armament Selector (overwrites common)
	TMS_fwd 	= CHAIN( L_CTL, D(10), UARROW );																// TMS fwd
	TMS_aft 	= CHAIN( L_CTL, D(10), DARROW );																// TMS aft
	TMS_right 	= CHAIN( L_CTL, D(10), RARROW );																// TMS right
	TMS_left 	= CHAIN( L_CTL, D(10), LARROW );																// TMS left
	
	// Display Management Switch (overwrites common)
	DMS_fwd 	= CHAIN( R_ALT, D(10), ';' );																	// Coolie up
	DMS_aft 	= CHAIN( R_ALT, D(10), '.' );																	// Coolie down
	DMS_right 	= CHAIN( R_ALT, D(10), '/' );																	// Coolie right
	DMS_left 	= CHAIN( R_ALT, D(10), ',' );																	// Coolie left

	// Buttons (overwrites common)
	LDGH_short	= 0;																							// 
	SC_short	= 'v';																							// China Hat Fwd


	// Keybindings
	eac_arm				= CHAIN( DOWN+R_SHIFT, D(10), PULSE+'e', D(), UP+R_SHIFT );								// EAC Arm
	ufcrocker_up		= CHAIN( DOWN+L_SHIFT, D(10), PULSE+';', D(), UP+L_SHIFT );								// UFC STEER UP Rocker switch
	ufcrocker_down		= CHAIN( DOWN+L_SHIFT, D(10), PULSE+'.', D(), UP+L_SHIFT );								// UFC STEER DOWN Rocker switch
	boatswitch_fwd		= CHAIN( DOWN+R_ALT, D(10), PULSE+RARROW, D(), UP+R_ALT );								// Boat Switch - Fwd
	boatswitch_centre	= CHAIN( DOWN+R_ALT, D(10), PULSE+DARROW, D(), UP+R_ALT );								// Boat Switch - Centre
	boatswitch_aft		= CHAIN( DOWN+R_ALT, D(10), PULSE+LARROW, D(), UP+R_ALT );								// Boat Switch - Aft
	CMS_fwd				= '7';																					// Countermeasures Management Switch - Fwd
	CMS_aft				= '8'; 																					// Countermeasures Management Switch - Aft
	CMS_right			= '0';																					// Countermeasures Management Switch - Right
	CMS_left			= '9'; 																					// Countermeasures Management Switch - Left
	CMS_push			= '-';																					// Countermeasures Management Switch - Push
	coolie_up			= HOME;																					// DMS up
	coolie_down			= END;																					// DMS down
	coolie_right		= PGDN; 																				// DMS right
	coolie_left			= DEL;																					// DMS left
	ltb_short			= 'q';																					// Left Throttle Button
	flaps_up			= CHAIN( DOWN+L_SHIFT, D(10), PULSE+'f', D(), UP+L_SHIFT );								// Flaps Up (3 steps: down, manoeuvre, up)
	flaps_down			= CHAIN( DOWN+L_CTL, D(10), PULSE+'f', D(), UP+L_CTL );									// Flaps Down

	// DX bindings
	//chinahat_fwd		= DX13;		- already defined in Common													// In Common this is bound to radar elevation
	//chinahat_back		= DX14;																					// In Common this is bound to radar elevation


	// Start-up Sequence (overwrites common)
	startup = SEQ( CHAIN( DOWN+R_SHIFT, D(10), PULSE+'s', D(), UP+R_SHIFT ), 									// Battery power
				   CHAIN( DOWN+L_ALT, D(10), PULSE+'s', D(), UP+L_ALT ), 										// Inverter STBY
				   CHAIN( DOWN+R_CTL, D(10), PULSE+'s', D(), UP+R_CTL )); 										// APU generator power

	// Gound Crew (overwrites common)
	ground_wheelchocks_remove	= CHAIN( PULSE+USB[0x31], D(200), PULSE+F11, D(200), PULSE+F8, D(200), PULSE+F5, D(200), PULSE+F2 );		// Radio menu (\), Prev, Ground crew, Wheel Chocks, Remove
	groundcrew 					= ground_wheelchocks_remove;																				// Radio menu (\), Prev, GroundCrew, Wheel Chocks, Remove

	// Master Modes function
	mastermode = 0;																								// mastermode 0,1,2,3		NAV, GUN, CCIP, CCRP
	deferdelay = 0;
	
	mastermodecontrolbutton = CHAIN( PULSE+'m',
									 EXEC( "mastermode = (mastermode+1)%4;" ));									// keeps track of current mastermode (assumes start in NAV)
							   
	mastermode_aa 			= CHAIN( DOWN+'m', D(1000), UP+'m' );												// master mode A-A
	
	mastermode_nav 			= EXEC( "while (mastermode != 0)  {"												// return to master mode NAV
									  "DeferCall( deferdelay, &ActKey, PULSE+KEYON+'m' );"						// delayed pulse to give a/c time to switch mode
									  "mastermode = (mastermode+1)%4;"											// walk through all modes (until NAV)
							 		  "deferdelay = deferdelay + 100;"											// delay is absolute, so needs to be increased for every while loop
							 		  //"printf(\" mastermode %i \\xa\", mastermode);"							// print current mastermode in output window
						   			"}" );

/* 
option: NAV geen control over MMCB, maar alleen in A2G
dan wel even naar A2G switchen om op nav mode te zetten...
*/


	// Exterior Lighting
	extlight_full 		= CHAIN( DOWN+L_CTL, D(10), PULSE+'p', D(), UP+L_CTL, D(100),									// Exterior Light per Lighting Panel (pinky switch aft)
						   		 DOWN+L_SHIFT+L_CTL, D(10), PULSE+'l', D(), UP+L_SHIFT+L_CTL, D(100),					// Anti-Collision Lights - ON
						   		 DOWN+L_ALT+L_CTL, D(10), PULSE+'m', D(), UP+L_ALT+L_CTL, D(100),						// Position Lights Steady
						   		 throttle_led4_on, D(),	 																// LED4 ON
						   		 DOWN+L_ALT+L_CTL, D(10), DOWN+'l', D(800), UP+'l', D(), UP+L_ALT+L_CTL );				// Formation Lights Decrease
	extlight_position 	= CHAIN( DOWN+L_ALT, D(10), PULSE+'p', D(), UP+L_ALT, D(100),									// position lights to dimsteady / strobes off (pinky switch fwd)
							     DOWN+L_ALT+L_CTL, D(10), PULSE+'m', D(), UP+L_ALT+L_CTL, D(),							// Position Lights Steady
							     throttle_led4_on, D(), 																// LED4 ON
							     DOWN+L_ALT+L_CTL, D(10), DOWN+'l', D(800), UP+'l', D(), UP+L_ALT+L_CTL );				// Formation Lights Decrease
	extlight_formation 	= CHAIN( DOWN+L_CTL, D(10), PULSE+'p', D(), UP+L_CTL, D(100),									// Exterior Light per Lighting Panel (pinky switch aft)
								 DOWN+L_ALT+L_CTL, D(10), PULSE+'k', D(), UP+L_ALT+L_CTL, D(100), 						// Position Lights Off
								 DOWN+L_ALT+L_SHIFT, D(10), DOWN+'l', D(400), UP+'l', D(), UP+L_ALT+L_SHIFT, D(100),	// Formation Lights Increase
								 throttle_led4_on );	 																// LED4 ON
	extlight_covert 	= CHAIN( DOWN+L_SHIFT, D(10), PULSE+'p', D(), UP+L_SHIFT, D(), 									// All Covert (pinky switch centre)
							 	 throttle_led4_off ); 																	// LED4 OFF	


	// Speedbrake functions (overwrites common)
	speedbrakes_open  = CHAIN( EXEC( "StopAutoRepeat(6);" ), D(), 												// stop repeat in case speedbrakes are still closing
							   DX32 );																			// press DX32 to open (Speed Brake Switch Aft)

	speedbrakes_close = CHAIN( REXEC( 6, 50, "ActKey( PULSE+KEYON+DX31 );", RNOSTOP ),							// press DX31 to close, every 50ms (Speed Brake Switch Forward)
							   D(3000),																			// repeat for 3 seconds
							   EXEC( "StopAutoRepeat(6);" ));													// stop repeat
						   




	// -------------------- COMMON CONTROLS -------------------------
					
	dcs_fighter_common_controls();						// load dcs COMMON controls
	dcs_fighter_common_mfd();							// load dcs MFD controls
														// before aircraft controls, to allow for overwriting of common controls when necessary


	// -------------------- AIRCRAFT CONTROLS -----------------------

	// ---------------------- FLIGHT STICK --------------------------

	// --DCS_Fighter_Common---------
	// TG - Camera/Gun Trigger
	// S1 - Nosewheel Steering Button
	// H1 - Trim Switch
	// JOYX
	// JOYY
	// -----------------------------	


	// Expand FOV Button - S3
	MapKeyUMD(&AVA_F16, S3,  	0,																				// U - [always use A-A]
							    PULSE+'m',															 			// M - [always use NAV]
							    mastermodecontrolbutton );														// D - Master Mode Control Button


 	// Countermeasure Management Switch
	// H4U
	MapKeyIO(&AVA_F16, H4U, 	boatswitch_fwd,																	// I - Boat Switch - Fwd
							 	CMS_fwd );																		// O - Countermeasures Management Switch - Fwd
	// H4D
	MapKeyIO(&AVA_F16, H4D, 	boatswitch_aft,																	// I - Boat Switch - Aft
							 	CMS_aft ); 																		// O - Countermeasures Management Switch - Aft
	// H4R
	MapKeyIO(&AVA_F16, H4R, 	boatswitch_centre,																// I - Boat Switch - Centre
			  				 	CMS_right );																	// O - Countermeasures Management Switch - Right
	// H4L
	MapKeyIO(&AVA_F16, H4L, 	0, 																				// I - 
							 	CMS_left ); 																	// O - Countermeasures Management Switch - Left
	// H4P
	MapKeyIO(&AVA_F16, H4P, 	0, 																				// I - 
							 	CMS_push );																		// O - Countermeasures Management Switch - Push



 
	// ------------------------ THROTTLE ----------------------------

	// --DCS_Fighter_Common---------
	// Left Throttle Button
	// SPDF/B
	// CHF/B
	// MSU/D/P
	// PSF/B
	// EACON/OFF Landing Gear
	// EOLIGN/OVER
	// EORIGN/OVER
	// EFLNORM/OVER
	// EFRNORM/OVER
	// SC
	// APUON/OFF
	// RDRNRM/DIS Canopy
	// IDLELON/IDLERON
	// THR_LEFT
	// THR_RIGHT
	// THR_FC
	// SCX
	// SCY
	// -----------------------------



	// Autopilot
	// APENG	
	MapKeyIO(&Throttle, APENG, 		0,																				// I - 
									'a' );																			// O - LAAP Engage/Disengage
	// APDIS
	MapKey(&Throttle, APDIS, 		0 ); 																			// 
	// APPAT
	MapKey(&Throttle, APPAT, 		PULSE+'2' );											 						// LAAP Path Hold
	// APAH
	MapKey(&Throttle, APAH, 		PULSE+'3' );																	// LAAP Altitude/Heading Hold
	// APALT
	MapKey(&Throttle, APALT, 		PULSE+'4' );																	// LAAP Altitude/Bank Hold

	
	// Landing Gear / EAC
	// EACON
	MapKeyIOUMD(&Throttle, EACON,	0, 																				// IU - 
									0,																				// OU - 
									eac_arm,																		// IM - EAC Arm
									gear_up, 																		// OM - gear up 
									0,																				// ID - 
									0 );																			// OD -
	// EACOFF
	MapKeyIOUMD(&Throttle, EACOFF, 	0, 																				// IU -
									0,																				// OU - 
									0,																				// IM - 
									gear_down, 																		// OM - gear down
									0,																				// ID - 
									0 );																			// OD -

	
	// Coolie Switch
	// CSU
	MapKeyIO(&Throttle, CSU, 		ufcrocker_down,																	// I - UFC STEER DOWN Rocker switch
									coolie_down );																	// O - DMS down
	// CSD
	MapKeyIO(&Throttle, CSD, 		ufcrocker_up,																	// I - UFC STEER UP Rocker switch
									coolie_up );																	// O - DMS up
	// CSR
	MapKeyIO(&Throttle, CSR, 		0, 																				// I - 
									coolie_right );																	// O - DMS right
	// CSL
	MapKeyIO(&Throttle, CSL, 		0,							 													// I - 
									coolie_left );																	// O - DMS left


	// Left Throttle Button (overwrite of common)
	MapKeyIO(&Throttle, LTB, 		eject, 																			// I - EJECT
									ltb_short );																	// O - Left Throttle Button
								

	// Flaps Switch 
	// FLAPU
	MapKey(&Throttle, FLAPU,  		flaps_up );																		// Flaps Up (to fully up - 0 deg)
	MapKeyR(&Throttle, FLAPU,  		flaps_down );																	// Flaps Down (to manoeuvre/takeoff - 7 deg)	
	// FLAPM
	MapKey(&Throttle, FLAPM, 		0 );																			// 
	// FLAPD
	MapKey(&Throttle, FLAPD,  		flaps_down );																	// Flaps Down (to fully down - 20 deg)
	MapKeyR(&Throttle, FLAPD,  		flaps_up );																		// Flaps Up (to manoeuvre/takeoff - 7 deg)


	// Engine Override Left
	// EFLNORM
	MapKeyIO(&Throttle, EFLNORM, 	0,																				// I - 
									CHAIN( PULSE+attcontrol_override, D(), throttle_led5_off ));					// O - Flight control - NORMAL  ********* FIX DX in DCS; LED5 OFF for NORMAL
	// EFLOVER
	MapKeyIO(&Throttle, EFLOVER, 	0,																				// I - 
									CHAIN( PULSE+attcontrol_override, D(), throttle_led5_on ));						// O - Flight control - MANUAL REVERSION    ********* FIX DX in DCS; LED5 ON for MANUAL


	// U LAYER - Air-to-Air Mode
	// BSF - LED1 ON/OFF
	MapKeyIO(&Throttle, BSF, 		0,																				// I - 
									CHAIN( mastermode_aa, D(100), throttle_led1_on ));								// O - A-A mode on; LED1 ON for U layer
	MapKeyRIO(&Throttle, BSF, 		0,																				// I - 
									CHAIN( PULSE+'m', D(100), throttle_led1_off ));									// O - A-A mode off; LED1 OFF for U layer
	
	// M LAYER - Navigation Mode
	// BSM - LED2 ON/OFF
	MapKey(&Throttle, BSM, 			CHAIN( D(200), throttle_led2_on ));												// LED2 ON for M layer
	MapKeyR(&Throttle, BSM, 		throttle_led2_off ); 															// LED2 OFF for M layer

	// D LAYER - Air-to-Ground Mode
	// BSB - LED3 ON/OFF
	MapKeyIO(&Throttle, BSB, 		0,																				// I -
									CHAIN( mastermodecontrolbutton, D(100),	throttle_led3_on ));					// O - A-G mode on; LED3 ON for D layer
	MapKeyRIO(&Throttle, BSB,	 	0,																				// I -
									CHAIN( mastermode_nav, D(100), throttle_led3_off ));							// O - A-G mode off; LED3 OFF for D layer


}	// =====  end main()  =========================================================================


// -------------------- AFTERBURNER DETENT --------------------------

int afterburnerdetent(int x)
{
	if (x == 1) {		// Activate detent
		SetCustomCurve(&Throttle, THR_LEFT, LIST(0,0, 25,25, 50,50, AB,AB, 100,AB));
	}
	else {				// Throttle back to full reach
		SetSCurve(&Throttle, THR_LEFT, 0, 0, 0, 0, 0);
	}
}



// ----------------------- EVENTHANDLE ------------------------------

int EventHandle(int type, alias o, int x)
{
	if ((&o == &Throttle) & (x == THR_LEFT)) {									// Detect left throttle position for afterburner detent
		if (afterburnerdetent_present & afterburnerdetent_lifted) {				// If afterburnerdetent present and detent is lifted
			if (Throttle[THR_LEFT] < (100-AB)*(2*AMAX)/100) {					//   If left throttle below afterburner detent value of AB%
				afterburnerdetent(1);											//     Re-engage detent
				afterburnerdetent_lifted = 0;									//     Detent is no longer lifted
			}
		} 
	}
	DefaultMapping(&o, x);
}