// DCS F-16C Viper Thrustmaster Warthog/AVA/MFD Script by Astro
// TARGET version 3.0.25.127
// version 3.0, Oct 2026


include "target.tmh"
include "DCS_Fighter_Common.tmc"


// -------------------------- INITIALISE ----------------------------

int CMS_fwd;
int CMS_aft;
int CMS_right;
int CMS_left;

int enable;
int antennaelev_up;
int antennaelev_down;
int mastermode_a2a;
int mastermode_a2g;
int masterarm_arm;
int masterarm_off;
int masterarm_sim;
int canopyhandle_toggle;
int ecmxmit_up;
int ecmxmit_down;
int cmprogram_cw;
int cmprogram_ccw;
int rfswitch_norm;
int rfswitch_quiet;
int rfswitch_silent;
int gndjettison_enable;
int gndjettison_off;
int overrideswitch_dog;
int overrideswitch_msl;
int overrideswitch_cent;
int mfd_right_osb06;
int icp_dedrocker_incr;
int icp_dedrocker_decr;
int icp_dobber_seq;
int icp_dobber_ret;
int icp_priobutton_0;
int icp_priobutton_7;
int fuelqtysel_cw;
int fuelqtysel_norm;
int mainpwr_pwr;
int mainpwr_batt;
int jfsswitch_start1;
int jfsswitch_start2;
int extlight_master_norm;
int extlight_master_accov;
int extlight_master_allcov;
int extlight_wingtail_brt;
int extlight_wingtail_off;
int extlight_fuselage_brt;
int extlight_fuselage_off;
int brake_parking;
int brake_antiskid;

int ap_roll_atthold;
int ap_roll_hdgsel;
int ap_roll_strgsel;
int ap_pitch_althold;
int ap_pitch_atthold;
int ap_pitch_apoff;
int autopilot_ALThold;	
int autopilot_ATThold;
int autopilot_off;
int autopilot;
char autopilot_mode = 0;

int parkingbrake_toggle;

int override_dogfight;	
char override_dog = 0;		

define AB 75											// detent position at AB% of full throttle reach


// -------------------------- MAIN F-16C ----------------------------------------------------------

int main()
{
	// -------------------- COMMON CONFIGURATION --------------------
					
	dcs_fighter_common_configuration();					// load dcs COMMON config
	

	// -------------------- COMMON FUNCTIONS ------------------------
					
	dcs_fighter_common_functions();						// load dcs COMMON functions


	// ------------------- AIRCRAFT KEYBINDINGS ---------------------

	// Target Management Switch / Armament Selector (overwrites common)
	TMS_fwd 	= CHAIN( R_CTL, D(10), UARROW );																// TMS fwd
	TMS_aft 	= CHAIN( R_CTL, D(10), DARROW );																// TMS aft
	TMS_right 	= CHAIN( R_CTL, D(10), RARROW );																// TMS right
	TMS_left 	= CHAIN( R_CTL, D(10), LARROW );																// TMS left

	// Display Management Switch (overwrites common)
	DMS_fwd 	= CHAIN( R_ALT, D(10), ';' );																	// DMS fwd
	DMS_aft 	= CHAIN( R_ALT, D(10), '.' );																	// DMS aft
	DMS_right 	= CHAIN( R_ALT, D(10), '/' );																	// DMS right
	DMS_left 	= CHAIN( R_ALT, D(10), ',' );																	// DMS left

	// Buttons (overwrite common)
	LDGH_short	= CHAIN( DOWN+L_CTL, D(10), DOWN+USB[0x55], D(100), UP+USB[0x55], D(), UP+L_CTL );				// ICP DRIFT CUTOUT/WARN RESET 3-pos Switch: WARN RESET <> NORM (Num *)
	SC_short	= PULSE+'d';																					// Expand/FOV Button

	// Countermeasure Management Switch
	CMS_fwd 	= CHAIN( DOWN+R_SHIFT, D(10), PULSE+';', D(), UP+R_SHIFT );										// Countermeasures Management Switch - Fwd
	CMS_aft 	= CHAIN( DOWN+R_SHIFT, D(10), PULSE+'.', D(), UP+R_SHIFT ); 									// Countermeasures Management Switch - Aft
	CMS_right 	= CHAIN( DOWN+R_SHIFT, D(10), PULSE+'/', D(), UP+R_SHIFT );										// Countermeasures Management Switch - Right
	CMS_left 	= CHAIN( DOWN+R_SHIFT, D(10), PULSE+',', D(), UP+R_SHIFT ); 									// Countermeasures Management Switch - Left

	// DX - A/C specific
	enable 					= DX24;																					// ENABLE Switch - Depress
	antennaelev_up			= chinahat_fwd; 																		// Antenna elevation up (DX13)
	antennaelev_down		= chinahat_back; 																		// Antenna elevation down (DX14)

	// Keybindings
	mastermode_a2a			= PULSE+'1';
	mastermode_a2g			= PULSE+'2';
	masterarm_arm			= CHAIN( DOWN+R_SHIFT, D(10), PULSE+'a', D(), UP+R_SHIFT );								// MASTER ARM Switch - MASTER ARM
	masterarm_sim			= CHAIN( DOWN+R_SHIFT+R_CTL, D(10), PULSE+'a', D(), UP+R_SHIFT+R_CTL );					// MASTER ARM Switch - SIMULATE
	masterarm_off			= CHAIN( DOWN+R_CTL, D(10), PULSE+'a', D(), UP+R_CTL );									// MASTER ARM Switch - OFF
	canopyhandle_toggle		= CHAIN( DOWN+L_SHIFT, D(10), PULSE+'c', D(), UP+L_SHIFT );								// Canopy Handle - DOWN/UP
	ecmxmit_up				= CHAIN( DOWN+L_SHIFT+L_CTL, D(10), PULSE+'f', D(), UP+L_SHIFT+L_CTL );					// ECM XMIT Switch - Up
	ecmxmit_down			= CHAIN( DOWN+L_SHIFT+L_CTL, D(10), PULSE+'v', D(), UP+L_SHIFT+L_CTL );					// ECM XMIT Switch - Down
	cmprogram_cw			= CHAIN( DOWN+L_CTL, D(10), PULSE+'f', D(), UP+L_CTL ); 								// PROGRAM Knob - CW
	cmprogram_ccw			= CHAIN( DOWN+L_SHIFT, D(10), PULSE+'f', D(), UP+L_SHIFT ); 							// PROGRAM Knob - CCW
	rfswitch_norm			= PULSE+'r';																			// RF Switch - NORM
	rfswitch_quiet			= CHAIN( DOWN+L_CTL, D(10), PULSE+'r', D(), UP+L_CTL );									// RF Switch - QUIET
	rfswitch_silent			= CHAIN( DOWN+R_CTL, D(10), PULSE+'r', D(), UP+R_CTL );									// RF Switch - SILENT
	gndjettison_enable		= CHAIN( DOWN+R_SHIFT, D(10), PULSE+'e', D(), UP+R_SHIFT );								// GND JETT ENABLE Switch - ENABLE
	gndjettison_off			= CHAIN( DOWN+R_CTL, D(10), PULSE+'e', D(), UP+R_CTL );									// GND JETT ENABLE Switch - OFF
	overrideswitch_cent		= CHAIN( DOWN+L_CTL, D(10), PULSE+'0', D(), UP+L_CTL );									// DOGFIGHT/Missile Override Switch - CENTER
	overrideswitch_dog		= CHAIN( DOWN+L_CTL, D(10), PULSE+'3', D(), UP+L_CTL );									// DOGFIGHT/Missile Override Switch - DOGFIGHT
	overrideswitch_msl		= CHAIN( DOWN+L_CTL, D(10), PULSE+'4', D(), UP+L_CTL );									// DOGFIGHT/Missile Override Switch - MISSILE OVERRIDE
	mfd_right_osb06			= CHAIN( DOWN+L_ALT+R_SHIFT, D(10), PULSE+'6', D(), UP+L_ALT+R_SHIFT );					// Switch AG weapon type (SMS page Right MFD OSB 6)
	icp_dedrocker_incr		= CHAIN( DOWN+L_CTL, D(10), PULSE+USB[0x57], D(), UP+L_CTL );							// ICP DED Increment/Decrement Switch - Increment   (L_CTL+NUM+)
	icp_dedrocker_decr		= CHAIN( DOWN+L_CTL, D(10), PULSE+USB[0x56], D(), UP+L_CTL );							// ICP DED Increment/Decrement Switch - Decrement   (L_CTL+NUM-)
	icp_dobber_seq			= CHAIN( L_CTL, D(10), RARROW ); 														// ICP Data Control Switch - SEQ (dobber sequence)
	icp_dobber_ret			= CHAIN( L_CTL, D(10), LARROW ); 														// ICP Data Control Switch - RET (dobber return)
	icp_priobutton_0		= CHAIN( L_CTL, D(10), KP0 );															// ICP Priority Function Button - 0 (M-SEL)
	icp_priobutton_7		= CHAIN( L_CTL, D(10), KP7 );															// ICP Priority Function Button - 7 (MARK)
	fuelqtysel_cw			= CHAIN( DOWN+R_CTL+R_SHIFT, D(10), PULSE+'v', D(), UP+R_CTL+R_SHIFT );					// FUEL QTY SEL Knob - CW
	fuelqtysel_norm			= CHAIN( DOWN+R_CTL+R_SHIFT, D(10), PULSE+'c', D(), UP+R_CTL+R_SHIFT ); 				// FUEL QTY SEL Knob - NORM
	mainpwr_pwr				= CHAIN( DOWN+R_SHIFT, D(10), DOWN+'s', D(100), UP+'s', D(), UP+R_SHIFT );				// MAIN PWR Switch - MAIN PWR
	mainpwr_batt			= CHAIN( DOWN+L_ALT, D(10), DOWN+'s', D(100), UP+'s', D(), UP+L_ALT );					// MAIN PWR Switch - BATT
	jfsswitch_start1		= CHAIN( DOWN+R_CTL, D(10), DOWN+'s', D(100), UP+'s', D(), UP+R_CTL );					// JFS Switch - START 1
	jfsswitch_start2		= CHAIN( DOWN+L_SHIFT, D(10), DOWN+'s', D(100), UP+'s', D(), UP+L_SHIFT );				// JFS Switch - START 2
	ap_roll_hdgsel			= CHAIN( DOWN+L_SHIFT, D(10), PULSE+'a', D(), UP+L_SHIFT ); 							// Autopilot ROLL Switch - HDG SEL
	ap_roll_atthold			= CHAIN( DOWN+L_CTL, D(10), PULSE+'a', D(), UP+L_CTL );									// Autopilot ROLL Switch - ATT HOLD
	ap_roll_strgsel			= CHAIN( DOWN+L_ALT, D(10), PULSE+'a', D(), UP+L_ALT );									// Autopilot ROLL Switch - STRG SEL
	ap_pitch_althold		= CHAIN( DOWN+L_CTL+L_SHIFT, D(10), DOWN+'p', D(100), UP+'p', D(), UP+L_CTL+L_SHIFT );	// Autopilot PITCH Switch - ALT HOLD
	ap_pitch_atthold		= CHAIN( DOWN+L_CTL+L_ALT, D(10), DOWN+'p', D(100), UP+'p', D(), UP+L_CTL+L_ALT );		// Autopilot PITCH Switch - ATT HOLD
	ap_pitch_apoff			= CHAIN( DOWN+L_CTL, D(10), DOWN+'p', D(100), UP+'p', D(), UP+L_CTL ); 					// Autopilot PITCH Switch - A/P OFF
	extlight_master_norm	= CHAIN( DOWN+R_SHIFT, D(10), PULSE+'l', D(), UP+R_SHIFT );								// MASTER Switch - NORM
	extlight_master_accov	= CHAIN( DOWN+R_CTL, D(10), PULSE+'l', D(), UP+R_CTL );									// MASTER Switch - A-C covert
	extlight_master_allcov 	= CHAIN( DOWN+L_CTL, D(10), PULSE+'l', D(), UP+L_CTL );									// MASTER Switch - ALL covert
	extlight_wingtail_brt	= CHAIN( DOWN+R_SHIFT+L_SHIFT, D(10), PULSE+'l', D(), UP+R_SHIFT+L_SHIFT );				// WING/TAIL Switch - BRT
	extlight_wingtail_off	= CHAIN( DOWN+R_SHIFT+L_CTL, D(10), PULSE+'l', D(), UP+R_SHIFT+L_CTL );					// WING/TAIL Switch - OFF
	extlight_fuselage_brt	= CHAIN( DOWN+R_CTL+L_SHIFT, D(10), PULSE+'l', D(), UP+R_CTL+L_SHIFT );					// FUSELAGE Switch - BRT
	extlight_fuselage_off	= CHAIN( DOWN+R_CTL+L_CTL, D(10), PULSE+'l', D(), UP+R_CTL+L_CTL );						// FUSELAGE Switch - OFF
	extlight_flashsteady	= CHAIN( DOWN+R_ALT, D(10), PULSE+'l', D(), UP+R_ALT );									// FLASH STEADY Switch - FLASH/STEADY
	brake_parking			= CHAIN( DOWN+R_CTL, D(10), PULSE+'p', D(), UP+R_CTL );									// ANTI-SKID Switch - PARKING BRAKE
	brake_antiskid			= CHAIN( DOWN+R_CTL+R_SHIFT, D(10), PULSE+'p', D(), UP+R_CTL+R_SHIFT );					// ANTI-SKID Switch - ANTI-SKID



	// -------------------- AIRCRAFT FUNCTIONS ----------------------


	// Start-up Sequence (overwrites common)
	startup 			= SEQ( mainpwr_batt, mainpwr_pwr, jfsswitch_start1 );									// MAIN PWR Switch - BATT; MAIN PWR Switch - MAIN PWR; JFS Switch - START 1


	// Autopilot function
	autopilot_ALThold 	= CHAIN( ap_pitch_althold, EXEC( "autopilot_mode = 1;" ));								// Autopilot PITCH Switch - ALT HOLD
	autopilot_ATThold 	= CHAIN( ap_pitch_atthold, EXEC( "autopilot_mode = 1;" ));								// Autopilot PITCH Switch - ATT HOLD
	autopilot_off 		= CHAIN( ap_pitch_apoff, EXEC( "autopilot_mode = 0;" ));								// Autopilot PITCH Switch - A/P OFF
	
	autopilot 			= EXEC( "if(!autopilot_mode) ActKey( PULSE+KEYON+autopilot_ALThold );"
					  			"if(autopilot_mode) ActKey( PULSE+KEYON+autopilot_off );"	);


	// External Lights
	extlight_full		= CHAIN( extlight_master_norm, D(100), extlight_wingtail_brt, D(100),					// MASTER Switch - NORM; WING/TAIL Switch - BRT
								 extlight_fuselage_brt, D(), throttle_led4_on );								// FUSELAGE Switch - BRT; LED4 ON
	extlight_position	= CHAIN( extlight_master_accov, D(100), extlight_wingtail_brt, D(100),					// MASTER Switch - A-C covert; WING/TAIL Switch - BRT
								 extlight_fuselage_off, D(), throttle_led4_on );								// FUSELAGE Switch - OFF; LED4 ON
	extlight_formation  = 0;																					// 
	extlight_covert		= CHAIN( extlight_master_allcov, D(100), extlight_wingtail_off, D(100),					// MASTER Switch - ALL covert; WING/TAIL Switch - OFF
								 extlight_fuselage_off, D(), throttle_led4_off );								// FUSELAGE Switch - OFF; LED4 OFF


	// A-A override function
	override_dogfight	= EXEC( "if(!override_dog) ActKey( PULSE+KEYON+overrideswitch_dog );"					// DOGFIGHT/Missile Override Switch - DOGFIGHT
								"if(override_dog) ActKey( PULSE+KEYON+overrideswitch_cent );"					// DOGFIGHT/Missile Override Switch - CENTER
								"override_dog = !override_dog;" ); 												// switch override_dog


	// Parking Brake 
	parkingbrake_toggle = SEQ( brake_parking, brake_antiskid );													// ANTI-SKID Switch - PARKING BRAKE; ANTI-SKID Switch - ANTI-SKID



	// -------------------- COMMON CONTROLS -------------------------
					
	dcs_fighter_common_controls();						// load dcs COMMON controls
	dcs_fighter_common_mfd();							// load dcs MFD controls
														// before aircraft controls, to allow for overwriting of common controls when necessary


	// -------------------- AIRCRAFT CONTROLS -----------------------

	// ---------------------- FLIGHT STICK --------------------------

	// Nosewheel Steering Button
	// S1
	MapKeyIOUMD(&AVA_F16, S1, 	F10map_toggle,																	// IU - F10 map
							 	nws, 																			// OU - NWS A/R DISC MSL STEP Button
							    F10map_toggle, 																	// IM - F10 map
							    nws,																		 	// OM - NWS A/R DISC MSL STEP Button
							    F10map_toggle,								 									// ID - F10 map
							    TEMPO( PULSE+nws,																// OD - [short] NWS A/R DISC MSL STEP Button
									   mfd_right_osb06, 500 ));													//		[long]  Switch AG weapon type (SMS page Right MFD OSB 6)


	// Expand FOV Button - S3
	MapKeyUMD(&AVA_F16, S3,     override_dogfight,																// U - dogfight override
							    autopilot,															 			// M - autopilot on/off (Autopilot PITCH Switch - ALT HOLD)
							    override_dogfight );															// D - dogfight override


 	// Countermeasure Management Switch
	// H4U
	MapKeyIO(&AVA_F16, H4U, 	ecmxmit_up,																		// I - ECM XMIT Switch - Up
							 	CMS_fwd );																		// O - Countermeasures Management Switch - Fwd
	// H4D
	MapKeyIO(&AVA_F16, H4D, 	ecmxmit_down,																	// I - ECM XMIT Switch - Down
							 	CMS_aft ); 																		// O - Countermeasures Management Switch - Aft
	// H4R
	MapKeyIO(&AVA_F16, H4R, 	cmprogram_cw, 																	// I - PROGRAM Knob - CW
			  				 	CMS_right );																	// O - Countermeasures Management Switch - Right
	// H4L
	MapKeyIO(&AVA_F16, H4L, 	cmprogram_ccw, 																	// I - PROGRAM Knob - CCW
							 	CMS_left ); 																	// O - Countermeasures Management Switch - Left
	// H4P
	MapKeyIO(&AVA_F16, H4P, 	0, 																				// I - 
							 	cm_dispense );																	// O - CHAFF/FLARE Dispense Button (program 5)



 
	// ------------------------ THROTTLE ----------------------------

	// Autopilot
	// APENG	
	MapKeyIO(&Throttle, APENG, 	autopilot_ATThold,																// I - Autopilot ATT on (Autopilot PITCH Switch - ATT HOLD)
								autopilot );																	// O - Autopilot ALT on or AP Off (Autopilot PITCH Switch - ALT HOLD)
	// APDIS
	MapKey(&Throttle, APDIS, 	0 ); 																			// 
	// APPAT
	MapKey(&Throttle, APPAT, 	ap_roll_hdgsel ); 																// Autopilot ROLL Switch - HDG SEL
	// APAH
	MapKey(&Throttle, APAH, 	ap_roll_atthold );																// Autopilot ROLL Switch - ATT HOLD
	// APALT
	MapKey(&Throttle, APALT, 	ap_roll_strgsel );																// Autopilot ROLL Switch - STRG SEL

	

	// Coolie Switch
	// CSU
	MapKeyIO(&Throttle, CSU, 	TEMPO( icp_dedrocker_decr,														// I - ICP DED Increment/Decrement Switch - Decrement   (L_CTL+NUM-)
							 		   seat_down, 500 ),														//	   [long] Seat down
								TEMPO( fuelqtysel_cw,															// O - FUEL QTY SEL Knob - CW
								       fuelqtysel_norm, 500 ));												 	//	   [long] FUEL QTY SEL Knob - NORM
	// CSD
	MapKeyIO(&Throttle, CSD, 	TEMPO( icp_dedrocker_incr,														// I - ICP DED Increment/Decrement Switch - Increment   (L_CTL+NUM+)
							 		   seat_up, 500 ),															//	   [long] Seat up
								enable );																		// O - ENABLE Switch - Depress
	// CSR
	MapKeyIO(&Throttle, CSR, 	icp_dobber_seq, 																// I - ICP Data Control Switch - SEQ (dobber sequence)
							 	sidewinder_uncage );															// O - UNCAGE Switch
	// CSL
	MapKeyIO(&Throttle, CSL, 	icp_dobber_ret, 																// I - ICP Data Control Switch - RET (dobber return)
							 	TEMPO( EXEC( "if(WHDN_mode) ActKey( PULSE+KEYON+parkingbrake_toggle );" 		// O - [WHDN] Toggle parking brake
											 "else ActKey (PULSE+KEYON+icp_priobutton_7);" ),					// 	   ICP Priority Function Button - 7 (MARK)
									   icp_priobutton_0, 500 ));												//	   [long] ICP Priority Function Button - 0 (M-SEL)
									   

	// China Hat (overwrite of common)
	// CHF
	MapKeyIO(&Throttle, CHF, 	brightness_up, 																	// I - brightness up for goggle/HMCS
							 	REXEC( 20, 200, "ActKey( PULSE+KEYON+antennaelev_up );" ));						// O - ANT ELEV Knob - CW/up    (REXEC to slow down repeat press)
	// CHB
	MapKeyIO(&Throttle, CHB, 	brightness_down,																// I - brightness down for goggle/HMCS
							 	REXEC( 21, 200, "ActKey( PULSE+KEYON+antennaelev_down );" ));					// O - ANT ELEV Knob - CCW/down    (REXEC to slow down repeat press)



	// Flaps Switch (RF Switch)
	// FLAPU
	MapKey(&Throttle, FLAPU,  	rfswitch_norm );																// RF Switch - NORM
	// FLAPM
	MapKey(&Throttle, FLAPM, 	rfswitch_quiet );																// RF Switch - QUIET
	// FLAPD
	MapKey(&Throttle, FLAPD,  	rfswitch_silent );																// RF Switch - SILENT


	// Canopy
	// RDRNRM
	MapKeyIOUMD(&Throttle, RDRNRM, 	0, 																				// IU - 
									0,																				// OU - 
									canopyhandle_toggle,															// IM - Canopy Handle - DOWN/UP
									canopy_toggle,																	// OM - Canopy - OPEN/CLOSE
									0,																				// ID - 
									0 );																			// OD - 

	// Engine Operation
	// EOLIGN in common
	// EOLNORM in common
	// EOLMOTOR
	MapKeyIO(&Throttle, EOLMOTOR, 	jfsswitch_start2,																// I - JFS Switch - START 2
									0 ); 																			// O - 
	// EORIGN (overwrites common)
	MapKey(&Throttle, EORIGN, 		0 ); 																			// only single engine
	// EORNORM in common
	// EORMOTOR in common

	// Engine Override Left
	// EFLNORM in Common			- MANUAL PITCH Override Switch - NORM
	// EFLOVER in Common			- MANUAL PITCH Override Switch - OVRD

	// Engine idle/off
	// IDLELON in common
	// IDLERON (overwrite of common)
	MapKey(&Throttle, IDLERON, 		0 );																			// only single engine


	// U LAYER - Air-to-Air Mode
	// BSF - LED1 ON/OFF
	MapKeyIO(&Throttle, BSF, 	CHAIN( override_dogfight, D(200), masterarm_arm, D(), throttle_led1_on ),					// I - DOGFIGHT/Missile Override Switch - DOGFIGHT; MASTER ARM Switch - MASTER ARM; LED1 ON for U layer
								CHAIN( mastermode_a2a, D(100), throttle_led1_on ));											// O - A-A mode on; LED1 ON for U layer
	MapKeyRIO(&Throttle, BSF, 	CHAIN( throttle_led1_off, D(),																// I - LED1 OFF for U layer
									   overrideswitch_cent, D(), EXEC( "override_dog = 0;" )),								//	   DOGFIGHT/Missile Override Switch - CENTER; reset dogfight override status
								CHAIN( mastermode_a2a, D(100), throttle_led1_off, D(),										// O - A-A mode off; LED1 OFF for U layer
									   overrideswitch_cent, D(), EXEC( "override_dog = 0;" )));								//	   DOGFIGHT/Missile Override Switch - CENTER; Reset, in case dogfight override was started when in A-A mode
	
	// M LAYER - Navigation Mode
	// BSM - LED2 ON/OFF
	MapKey(&Throttle, BSM, 		throttle_led2_on );																			// LED2 ON for M layer
	MapKeyR(&Throttle, BSM, 	throttle_led2_off ); 																		// LED2 OFF for M layer

	// D LAYER - Air-to-Ground Mode
	// BSB - LED3 ON/OFF
	MapKeyIO(&Throttle, BSB, 	CHAIN( mastermode_a2g, D(100), masterarm_sim, D(), gndjettison_enable ),					// I - A-G mode on; MASTER ARM Switch - SIMULATE; GND JETT ENABLE Switch - ENABLE
								CHAIN( mastermode_a2g, D(100), throttle_led3_on ));											// O - A-G mode on; LED3 ON for D layer
	MapKeyRIO(&Throttle, BSB, 	CHAIN( mastermode_a2g, D(100), masterarm_off, D(), gndjettison_off ),						// I - A-G mode off; MASTER ARM Switch - OFF; GND JETT ENABLE Switch - OFF
								CHAIN( mastermode_a2g, D(100), throttle_led3_off, D(),										// O - A-G mode off; LED3 OFF for D layer
									   overrideswitch_cent, D(), EXEC( "override_dog = 0;" )));								//	   DOGFIGHT/Missile Override Switch - CENTER; Reset, in case dogfight override was started when in A-G mode


	// ---------------------------- MFD -----------------------------

	// Backup on Left MFD for MAN RNG Knob
	MapKeyIO(&LMFD, SYMU, 		CHAIN( R_WIN+R_SHIFT, D(10), 'o' ), 													// I - Right MFD SYM Up
								CHAIN( R_WIN+R_CTL, D(10), 'o' ));														// O - MAN RNG Knob - CW

	MapKeyIO(&LMFD, SYMD, 		CHAIN( R_WIN+R_SHIFT, D(10), 'k' ), 													// I - Right MFD SYM Down
								CHAIN( R_WIN+R_CTL, D(10), 'k' ));														// O - MAN RNG Knob - CCW



}	// =====  end main()  =========================================================================




// -------------------- AFTERBURNER DETENT --------------------------

int afterburnerdetent(int x)
{
	if (x == 1) {		// Activate detent
		SetCustomCurve(&Throttle, THR_LEFT, LIST(0,0, 25,25, 50,50, AB,AB, 100,AB));
	}
	else {				// Throttle back to full reach
		SetSCurve(&Throttle, THR_LEFT, 0, 0, 0, 0, 0);
	}
}



// ------------------------ EVENTHANDLE -----------------------------

int EventHandle(int type, alias o, int x)
{
	if ((&o == &Throttle) & (x == THR_LEFT)) {									// Detect left throttle position for afterburner detent
		if (afterburnerdetent_present & afterburnerdetent_lifted) {				// If afterburnerdetent present and detent is lifted
			if (Throttle[THR_LEFT] < (100-AB)*(2*AMAX)/100) {					//   If left throttle below afterburner detent value of AB%
				afterburnerdetent(1);											//     Re-engage detent
				afterburnerdetent_lifted = 0;									//     Detent is no longer lifted
			}
		} 
	}
	DefaultMapping(&o, x);
}